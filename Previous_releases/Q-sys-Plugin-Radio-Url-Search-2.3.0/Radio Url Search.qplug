------------------------------ Local Functions --------------------------------
function HEXtoDEC(hex)
	hex = string.upper(hex)
	local b1 = string.byte(string.sub(hex, 1, 1))
	local b2 = string.byte(string.sub(hex, 2, 2))
  
	return( (b1<=57 and b1-48 or b1-55)*16 + (b2<=57 and b2-48 or b2-55) )
end

function ConvertColor(c)
	local t = {}
	t[1] = HEXtoDEC(string.sub(c,2,3))
	t[2] = HEXtoDEC(string.sub(c,4,5))
	t[3] = HEXtoDEC(string.sub(c,6,7))
	return t
end

if Controls then
rapidjson = require("rapidjson")

strSearch = Controls.StrSearch
stations = {}
searchRequestId = 0
local currentStation = nil
local stationRevision = 0
local presets = {}
local selectedPreset = 1
local presetCount = Properties["Preset Count"].Value
RESULT_COUNT = #Controls.SelectBtn

local EMPTY_RESULT_FAVICON = false

-- Artwork is fetched by the Core; UCI clients only receive an SVG legend.
local MAX_LOGO_BYTES = 512 * 1024
local MAX_LOGO_DIMENSION = 512
local function svgLegend(svg)
    return rapidjson.encode({
        DrawChrome = false,
        IconData = Crypto.Base64Encode(svg),
        Legend = "",
    })
end
local fallbackSvg = [[<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 300 300">
<rect x="0" y="0" width="300" height="300" rx="30" ry="30" fill="#ffffff"/>
<rect x="35" y="90" width="230" height="165" rx="22" fill="#374151"/>
<path d="M65 90 L225 40" stroke="#9ca3af" stroke-width="12" stroke-linecap="round"/>
<circle cx="105" cy="173" r="46" fill="#9ca3af"/><circle cx="105" cy="173" r="29" fill="#374151"/>
<rect x="172" y="126" width="60" height="18" fill="#9ca3af"/>
<path d="M174 174 H233 M174 199 H233" stroke="#9ca3af" stroke-width="10"/>
</svg>]]
local fallbackLegend = svgLegend(fallbackSvg)

local function renderLogo(state, svg)
    if state.resultIndex then
        svg = '<svg xmlns="http://www.w3.org/2000/svg" width="62" height="60" viewBox="0 0 62 60">'
            .. '<g transform="translate(3 2) scale(0.186666667)">' .. svg .. '</g></svg>'
    end
    state.control.Legend = svgLegend(svg)
end
local logoStates = {}
local activeLogoRequest = nil
-- Keep just the most recent successful artwork, plus a dedicated active-station cache.
local lastLogoUrl, lastLogoSvg, stationLogoUrl, stationLogoSvg
local lastLogoFailureTime = nil

local function logoFailure(reason)
    local now = os.time()
    if not lastLogoFailureTime or now - lastLogoFailureTime >= 10 then
        print("Station logo: " .. reason .. "; using radio placeholder (messages limited to one per 10s)")
        lastLogoFailureTime = now
    end
end

local function registerLogo(control)
    control.Boolean = false
    -- Disabled controls are dimmed in Live/Emulate, including their SVG artwork.
    -- Keep artwork enabled; the momentary handler clears presses without tuning.
    control.IsDisabled = false
    control.Legend = fallbackLegend
    control.EventHandler = function(c) c.Boolean = false end
    local state = { control = control, revision = 0 }
    logoStates[#logoStates + 1] = state
    return state
end
local stationLogo = registerLogo(Controls.StationLogo)
local presetLogo = registerLogo(Controls.PresetFavicon)
local resultLogos = {}
for i, control in ipairs(Controls.SelectBtn) do
    resultLogos[i] = registerLogo(control)
    resultLogos[i].resultIndex = i
end

local function headerValue(headers, name)
    for key, value in pairs(headers or {}) do
        if type(key) == "string" and key:lower() == name then
            if type(value) == "table" then value = value[1] end
            return type(value) == "string" and value or nil
        end
    end
    return nil
end

local function pngError(code, data, err, headers)
    if err and err ~= "" then return "download error: " .. tostring(err) end
    if code ~= 200 then return "HTTP " .. tostring(code) end
    if type(data) ~= "string" or #data == 0 then return "empty image" end
    local length = tonumber(headerValue(headers, "content-length"))
    if #data > MAX_LOGO_BYTES or (length and length > MAX_LOGO_BYTES) then return "image exceeds 512 KiB" end
    local contentType = headerValue(headers, "content-type")
    if contentType then
        contentType = contentType:lower():match("^%s*([^;%s]+)")
        if contentType ~= "image/png" and contentType ~= "image/x-png"
            and contentType ~= "application/octet-stream" then return "unexpected Content-Type" end
    end
    if data:sub(1, 8) ~= "\137PNG\r\n\26\n" then return "invalid PNG signature" end
    local function uint32(pos)
        local a, b, c, d = data:byte(pos, pos + 3)
        return ((a * 256 + b) * 256 + c) * 256 + d
    end
    local pos, hasHeader, hasData = 9, false, false
    while pos + 11 <= #data do
        local size = uint32(pos)
        local kind = data:sub(pos + 4, pos + 7)
        if size > #data - pos - 11 then return "truncated PNG chunk" end
        if not hasHeader then
            if kind ~= "IHDR" or size ~= 13 then return "missing PNG header" end
            local width, height = uint32(pos + 8), uint32(pos + 12)
            if width < 1 or height < 1 or width > MAX_LOGO_DIMENSION or height > MAX_LOGO_DIMENSION then
                return "invalid or oversized PNG dimensions"
            end
            local depth, color, compression, filter, interlace = data:byte(pos + 16, pos + 20)
            local depths = { [0] = {1, 2, 4, 8, 16}, [2] = {8, 16}, [3] = {1, 2, 4, 8},
                [4] = {8, 16}, [6] = {8, 16} }
            local validDepth = false
            for _, allowed in ipairs(depths[color] or {}) do
                if depth == allowed then validDepth = true end
            end
            if not validDepth or compression ~= 0 or filter ~= 0 or interlace > 1 then
                return "invalid PNG header fields"
            end
            hasHeader = true
        elseif kind == "IHDR" then return "duplicate PNG header" end
        if kind == "IDAT" and size > 0 then hasData = true end
        if kind == "IEND" then
            if size == 0 and hasData and pos + 11 == #data then return nil end
            return "invalid PNG ending"
        end
        pos = pos + size + 12
    end
    return "incomplete PNG"
end

local pumpLogos
-- Round the backing tile, never the artwork: trimmed logos can touch every edge.
-- An inset keeps the complete image clear of the tile's rounded corners.
local function artworkSvg(data)
    return '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="300" height="300" viewBox="0 0 300 300">'
        .. '<rect x="0" y="0" width="300" height="300" rx="30" ry="30" fill="#ffffff"/>'
        .. '<image x="12" y="12" width="276" height="276" preserveAspectRatio="xMidYMid meet" xlink:href="data:image/png;base64,'
        .. Crypto.Base64Encode(data) .. '"/></svg>'
end

pumpLogos = function()
    if activeLogoRequest then return end
    for _, state in ipairs(logoStates) do
        if state.pending then
            state.pending = false
            local url, revision = state.url, state.revision
            local cached = url == stationLogoUrl and stationLogoSvg
                or url == lastLogoUrl and lastLogoSvg
            if cached then
                renderLogo(state, cached)
                if state == stationLogo then stationLogoUrl, stationLogoSvg = url, cached end
            else
                local request = { state = state, revision = revision }
                activeLogoRequest = request
                local function done(_, code, data, err, headers)
                    if activeLogoRequest ~= request then return end
                    activeLogoRequest = nil
                    if state.revision == revision then
                        local reason = pngError(code, data, err, headers)
                        if not reason then
                            local ok, svg = pcall(function()
                                local svgString = artworkSvg(data)
                                renderLogo(state, svgString)
                                return svgString
                            end)
                            if ok then
                                lastLogoUrl, lastLogoSvg = url, svg
                                if state == stationLogo then stationLogoUrl, stationLogoSvg = url, svg end
                            else reason = "SVG encoding failed" end
                        end
                        if reason then
                            renderLogo(state, fallbackSvg)
                            logoFailure(reason)
                        end
                    end
                    pumpLogos()
                end
                -- Download buffers the body before this callback. The byte limit above
                -- bounds encoding/cache memory, not HttpClient's receive buffer.
                local ok, err = pcall(function()
                    HttpClient.Download {
                        Url = "https://images.weserv.nl/?url=" .. urlEncode(url)
                            -- Trim uniform outer padding before fitting the visible logo.
                            .. "&output=png&w=300&h=300&fit=inside&trim=1",
                        Headers = { Accept = "image/png" }, Timeout = 10, EventHandler = done
                    }
                end)
                if not ok then done(nil, 0, nil, tostring(err), {}) end
                return
            end
        end
    end
end

local function setLogo(state, url, stationKey)
    url = type(url) == "string" and url:match("^%s*(.-)%s*$") or ""
    if not url:match("^https?://[^/%s?#]+") or url:find("[%s%c]") then url = "" end
    if state.url == url and state.stationKey == stationKey then return end
    state.url, state.stationKey = url, stationKey
    state.revision = state.revision + 1
    state.control.Boolean = false
    renderLogo(state, fallbackSvg)
    state.pending = url ~= "" and Properties["Enable Logo Pages"].Value
    local cached = url == stationLogoUrl and stationLogoSvg
        or url == lastLogoUrl and lastLogoSvg
    if state.pending and cached then
        renderLogo(state, cached)
        state.pending = false
        if state == stationLogo then stationLogoUrl, stationLogoSvg = url, cached end
    end
    pumpLogos()
end

function setFaviconControl(index, url)
    local hidden = url == EMPTY_RESULT_FAVICON
    local station = stations[index]
    local key = not hidden and station and ((station.url or "") .. "\n" .. (station.name or "")) or nil
    setLogo(resultLogos[index], hidden and "" or url, key)
    Controls.SelectBtn[index].IsInvisible = hidden
    Controls.ResultName[index].IsInvisible = hidden
    Controls.ResultName[index].Legend = not hidden and station and station.name or ""
end

function setNowPlayingFavicon(url)
    setLogo(stationLogo, url, currentStation and currentStation.url)
end

function funcResetUI()
  for i, _ in pairs(Controls.SelectBtn) do
    setFaviconControl(i, EMPTY_RESULT_FAVICON)
  end

end

Components = Component.GetComponents()
URLReceiverComponents = {}

for key,value in pairs(Components) do
  if value.Type == "URL_receiver" then
    table.insert(URLReceiverComponents,value.Name)
  end
end

Controls.ReceiverComponent.Choices = URLReceiverComponents

function setReceiver(name)
  stationRevision = stationRevision + 1
  currentStation = nil
  Controls.NowPlaying.String = ""
  setNowPlayingFavicon("")
  if not name or name == "" then
    selectedreceiver = nil
    return
  end

  selectedreceiver = Component.New(name)
end

setReceiver(Controls.ReceiverComponent.String)

Controls.ReceiverComponent.EventHandler = function()
  setReceiver(Controls.ReceiverComponent.String)
  funcGetCurrentStation()
end

function formatStationName(name)
  if not name or name == "" then
    return ""
  end

  if string.len(name) <= 100 then
    return name
  end

  return string.sub(name, 1, 97) .. "..."
end

function tuneStation(station)
  if not station or type(station.url) ~= "string" or station.url == "" then
    return false
  end
  if not selectedreceiver or not selectedreceiver["url"] then
    print("Cannot tune station: selected Media Stream Receiver is unavailable")
    return false
  end

  selectedreceiver["url"].String = station.url
  if selectedreceiver["enable"] then
    selectedreceiver["enable"].Boolean = true
  end
  stationRevision = stationRevision + 1
  currentStation = { url = station.url, name = station.name or station.url, favicon = station.favicon or "" }
  Controls.NowPlaying.String = formatStationName(currentStation.name)
  setNowPlayingFavicon(currentStation.favicon)
  return true
end

function selectStation(index)
  if tuneStation(stations[index]) then
    Controls.StrSearchResult.Value = index
  end
end

local function refreshPresets()
    local choices = {}
    for i = 1, presetCount do
        local preset = presets[tostring(i)]
        choices[i] = string.format("%02d - %s", i, preset and formatStationName(preset.name) or "Empty")
    end
    Controls.PresetList.Choices = choices
    Controls.PresetList.String = choices[selectedPreset]
    local preset = presets[tostring(selectedPreset)]
    Controls.PresetName.String = preset and preset.name or "Empty preset"
    Controls.PresetUrl.String = preset and preset.url or ""
    setLogo(presetLogo, preset and preset.favicon or "", preset and preset.url)
    Controls.PresetRecall.IsDisabled = preset == nil
    Controls.PresetDelete.IsDisabled = preset == nil
end

local function loadPresets()
    presets = {}
    local data = Controls.PresetData.String
    if data ~= "" then
        local ok, saved = pcall(rapidjson.decode, data)
        if not ok or type(saved) ~= "table" then
            Controls.PresetStatus.String = "Saved preset data could not be read."
            refreshPresets()
            return
        end
        for key, preset in pairs(saved) do
            local slot = tonumber(key)
            if slot and slot >= 1 and slot <= 40 and slot == math.floor(slot)
                and type(preset) == "table" and type(preset.url) == "string" and preset.url ~= ""
                and type(preset.name) == "string" and type(preset.favicon) == "string" then
                presets[tostring(slot)] = { url = preset.url, name = preset.name, favicon = preset.favicon }
            end
        end
    end
    refreshPresets()
end

Controls.PresetList.EventHandler = function(ctrl)
    for i, choice in ipairs(ctrl.Choices) do
        if ctrl.String == choice then
            selectedPreset = i
            Controls.PresetStatus.String = ""
            refreshPresets()
            return
        end
    end
end

Controls.PresetSave.EventHandler = function()
    local receiverUrl = selectedreceiver and selectedreceiver["url"]
    if not receiverUrl or receiverUrl.String == "" then
        Controls.PresetStatus.String = "Play a station before saving a preset."
        return
    end
    if not currentStation or currentStation.url ~= receiverUrl.String then
        Controls.PresetStatus.String = "Station details are unavailable. Select the station in Search first."
        return
    end
    presets[tostring(selectedPreset)] = {
        url = currentStation.url, name = currentStation.name, favicon = currentStation.favicon
    }
    Controls.PresetData.String = rapidjson.encode(presets)
    refreshPresets()
    Controls.PresetStatus.String = "Saved preset " .. selectedPreset .. ": " .. currentStation.name
end

Controls.PresetRecall.EventHandler = function()
    local preset = presets[tostring(selectedPreset)]
    if not preset then
        Controls.PresetStatus.String = "This preset is empty."
    elseif tuneStation(preset) then
        Controls.PresetStatus.String = "Recalled preset " .. selectedPreset .. ": " .. preset.name
    else
        Controls.PresetStatus.String = "Cannot recall: selected receiver unavailable."
    end
end

Controls.PresetDelete.EventHandler = function()
    presets[tostring(selectedPreset)] = nil
    Controls.PresetData.String = rapidjson.encode(presets)
    refreshPresets()
    Controls.PresetStatus.String = "Deleted preset " .. selectedPreset .. "."
end

Controls.PresetData.EventHandler = loadPresets
Controls.PresetStatus.String = "Save replaces the selected slot. Delete clears it without stopping playback."

function funcGetRadio(requestId, tbl, code, data, err, headers)
    print(string.format(
        "HTTP response from '%s': Return Code=%i; Error=%s",
        tbl.Url, code, err or "None"
    ))

    if requestId ~= searchRequestId then
        print("Ignoring stale radio search response")
        return
    end

    if code ~= 200 then
        Timer.CallAfter(funcSearchRadio, 1)
        return
    end

    local radios = rapidjson.decode(data)
    if not radios then return end

    local stationMap = {}
    stations = {}
    local choices = {}

    for _, station in ipairs(radios) do
        local name = station.name or "Unknown"
        local url  = station.url_resolved or station.url
        local clickcount = station.clickcount or 0
        local favicon = station.favicon or ""
        local codec = string.upper(station.codec or "")

        local key = string.lower(name)

        -- Only keep playable MP3/MPEG stations
        if codec == "MP3" or codec == "MPEG" then
            if not stationMap[key] or clickcount > stationMap[key].clickcount then
                stationMap[key] = {
                    name = name,
                    url = url,
                    clickcount = clickcount,
                    favicon = favicon or ""
                }
            end
        end
    end

    -- Convert map to array, only stations with playable URL
    for _, s in pairs(stationMap) do
        if s.url then
            table.insert(stations, s)
        end
    end

    table.sort(stations, function(a, b)
        return a.clickcount > b.clickcount
    end)

    -- Clear previous result images
    funcResetUI()

    local faviconUrls = {}

    -- Build UI choices and names first
    for i, s in ipairs(stations) do
        if i <= RESULT_COUNT then
          s.displayName = formatStationName(s.name)
          choices[i] = s.displayName

          if s.favicon and s.favicon ~= "" then
            faviconUrls[i] = s.favicon
          else
            faviconUrls[i] = ""
          end

        end
    end

    Controls.StrSearchResult.Choices = choices

    if #choices > 0 then
        Controls.StrSearchResult.Value = 1
    end

    -- Queue artwork after results are filtered and named.
    for i, favicon in ipairs(faviconUrls) do
        setFaviconControl(i, favicon)
    end
end

countryCodeByName = {}

function funcSearchRadio()
    searchRequestId = searchRequestId + 1
    local requestId = searchRequestId

    local choices = {"Searching..."}
    Controls.StrSearchResult.Choices = choices

    local search = string.gsub(strSearch.String, " ", "+")
    local countryCode = selectedCountryCode or "BE"
    local countryFilter = ""
    if countryCode and countryCode ~= "" then
        countryFilter = "&countrycode=" .. countryCode
    end

    local url = string.format(
        "https://de1.api.radio-browser.info/json/stations/search?name=%s%s&limit=200&hidebroken=true&order=name",
        search,
        countryFilter
    )

    HttpClient.Get{
        Url = url,
        Timeout = 30,
        EventHandler = function(tbl, code, data, err, headers)
            funcGetRadio(requestId, tbl, code, data, err, headers)
        end
    }
end

function funcParceCountryCodes(tbl, code, data, err, headers)
    print(string.format(
        "HTTP response from '%s': Return Code=%i; Error=%s",
        tbl.Url, code, err or "None"
    ))

    local countries = rapidjson.decode(data)

    local choices = {}
    countryCodeByName = {}

    for _, country in ipairs(countries) do
        if country.name and country.iso_3166_1 then
            table.insert(choices, country.name)
            countryCodeByName[country.name] = country.iso_3166_1
        end
    end

    table.sort(choices)
    table.insert(choices, 1, "All")
    countryCodeByName["All"] = ""

    Controls.Country_Code.Choices = choices
    if countryCodeByName[Controls.Country_Code.String] == nil then
        Controls.Country_Code.String = "All"
    end
    selectedCountryCode = countryCodeByName[Controls.Country_Code.String]
end

function funcGetCountryCodes()
  url = "https://de1.api.radio-browser.info/json/countries"
  HttpClient.Get{Url = url, Timeout = 30, EventHandler = funcParceCountryCodes}
end

strSearch.EventHandler = function()
  funcResetUI()
  strSearch.String = string.gsub(strSearch.String, "[\r\n]", "")
  funcSearchRadio()
end

Controls.Country_Code.EventHandler = function(ctrl)
    local selectedCountryName = ctrl.String

    selectedCountryCode = countryCodeByName[selectedCountryName]

    print("Selected country: " .. tostring(selectedCountryName))
    print("Selected country code: " .. tostring(selectedCountryCode))

    searchRequestId = searchRequestId + 1
    Controls.StrSearch.String = ""
    Controls.StrSearchResult.Choices = {}
    funcResetUI()
end

Controls.StrSearchResult.EventHandler = function()
  for i,v in ipairs(Controls.StrSearchResult.Choices) do
    if stations[i] and Controls.StrSearchResult.String == stations[i].displayName then
      selectStation(i)
    end
  end
end

if Controls.SelectBtn then
  for i, btn in ipairs(Controls.SelectBtn) do
    btn.EventHandler = function()
      btn.Boolean = false
      if btn.IsInvisible then return end
      selectStation(i)
    end
    Controls.ResultName[i].EventHandler = function()
      Controls.ResultName[i].Boolean = false
      if Controls.ResultName[i].IsInvisible then return end
      selectStation(i)
    end
  end
end

function urlEncode(str)
    if not str then return "" end

    return string.gsub(str, "([^%w%-_%.~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
end

function funcRestoreNowPlaying(tbl, code, data, err, headers, streamUrl, revision)
    print(string.format(
        "Restore response: Return Code=%i; Error=%s",
        code,
        err or "None"
    ))

    if code ~= 200 or revision ~= stationRevision or not selectedreceiver
        or not selectedreceiver["url"] or selectedreceiver["url"].String ~= streamUrl then
        return
    end

    local stations = rapidjson.decode(data)

    if stations and stations[1] and stations[1].name then
        currentStation = { url = streamUrl, name = stations[1].name, favicon = stations[1].favicon or "" }
        Controls.NowPlaying.String = formatStationName(stations[1].name)
        setNowPlayingFavicon(currentStation.favicon)
        print("Restored station: " .. stations[1].name)
    end
end

function funcGetCurrentStation()
    if not selectedreceiver or not selectedreceiver["url"] then
        return
    end

    local streamUrl = selectedreceiver["url"].String

    if streamUrl == nil or streamUrl == "" then
        return
    end

    local lookupUrl =
        "https://de1.api.radio-browser.info/json/stations/byurl?url="
        .. urlEncode(streamUrl)

    print("Looking up station: " .. lookupUrl)

    local revision = stationRevision
    HttpClient.Get{
        Url = lookupUrl,
        Timeout = 10,
        EventHandler = function(tbl, code, data, err, headers)
            funcRestoreNowPlaying(tbl, code, data, err, headers, streamUrl, revision)
        end
    }
end

loadPresets()

Controls.StrSearch.String = ""

choices = {}
Controls.StrSearchResult.Choices = choices

funcGetCountryCodes()

Timer.CallAfter(function()
    funcGetCurrentStation()
end, 2)

funcResetUI()

end -- if Controls
