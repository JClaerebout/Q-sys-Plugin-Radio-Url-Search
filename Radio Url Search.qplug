--------------------------------- Properties ----------------------------------
function GetProperties()
    local props = {
        {
            Name = "Name",
            Type = "string",
            Value = "Radio Url Search"
        },
        {
            Name = "Location",
            Type = "string",
            Value = "Default Location"
        },
        {
            Name = "Result Count",
            Type = "integer",
            Value = 20,
            Min = 1,
            Max = 40,
        },
        {
            Name = "Preset Count",
            Type = "integer",
            Value = 10,
            Min = 1,
            Max = 40,
        },
        {
            Name = "Enable Favicon Pages",
            Type = "boolean",
            Value = false,
        },
    }

    return props
end

function RectifyProperties(props)
    return props
end

------------------------- Plugin Block Name and Color -------------------------
function GetPrettyName(props)
    return PluginInfo["Name"] .. " v" .. PluginInfo["Version"]
end

function GetColor(props)
	return ConvertColor("#cccccc")
end

---------------------------------- Controls -----------------------------------
function GetControls(props)
    local ctls = { }

    -- Editable text controls retain saved preset data as part of the design.
    table.insert(ctls, { Name = "PresetData", ControlType = "Text", UserPin = false })
    table.insert(ctls, { Name = "PresetList", ControlType = "Text", UserPin = false })
    for _, name in ipairs({ "PresetName", "PresetUrl", "PresetFavicon", "PresetStatus" }) do
        table.insert(ctls, {
            Name = name, ControlType = "Indicator", IndicatorType = "Text", UserPin = false
        })
    end
    for _, action in ipairs({ "Save", "Recall", "Delete" }) do
        table.insert(ctls, {
            Name = "Preset" .. action, ControlType = "Button", ButtonType = "Trigger", UserPin = false
        })
    end

	if ENABLE_CODE_PIN then
		table.insert(ctls, {
            Name = "code",
            ControlType = "Text",
            Count = 1,
            PinStyle = "Input",
            UserPin = true
        })
	end

    table.insert(ctls, {
        Name = "StrSearch",
        ControlType = "Text",
        Count = 1,
        PinStyle = "Input",
        UserPin = true
    })

    table.insert(ctls, {
        Name = "StrSearchResult",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "Country_Code",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "ReceiverStatus",
        ControlType = "Indicator",
        IndicatorType = "Status",
        Count = 1,
        PinStyle = "Output",
        UserPin = true
    })

    table.insert(ctls, {
        Name = "interface",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "NowPlaying",
        ControlType = "Indicator",
        IndicatorType = "Text",
        Count = 1,
        PinStyle = "Output",
        UserPin = true
    })

    table.insert(ctls, {
        Name = "favicon",
        ControlType = "Indicator",
        IndicatorType = "Text",
        Count = props["Result Count"].Value,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "Name",
        ControlType = "Indicator",
        IndicatorType = "Text",
        Count = props["Result Count"].Value,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "SelectBtn",
        ControlType = "Button",
        ButtonType = "Trigger",
        Count = props["Result Count"].Value,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "NowPlayingFavicon",
        ControlType = "Indicator",
        IndicatorType = "Text",
        Count = 1,
        UserPin = false
    })

    for channel = 1, 2 do
        local prefix = "channel." .. channel .. "."

        table.insert(ctls, {
            Name = prefix .. "gain",
            ControlType = "Knob",
            ControlUnit = "dB",
            Min = -100,
            Max = 20,
            DefaultValue = 0,
            PinStyle = "Both",
            UserPin = true
        })

        table.insert(ctls, {
            Name = prefix .. "invert",
            ControlType = "Button",
            ButtonType = "Toggle",
            PinStyle = "Both",
            UserPin = true
        })

        table.insert(ctls, {
            Name = prefix .. "mute",
            ControlType = "Button",
            ButtonType = "Toggle",
            PinStyle = "Both",
            UserPin = true
        })

        table.insert(ctls, {
            Name = prefix .. "peak.level",
            ControlType = "Indicator",
            IndicatorType = "Meter",
            ControlUnit = "dB",
            Min = -120,
            Max = 43,
            PinStyle = "Output",
            UserPin = true
        })
    end

    return ctls
end

