        local resultStartX = 24
        local resultStartY = 24
        local columnWidth = 270
        local rowHeight = 68
        local tileWidth = 248
        local tileHeight = 60
        local visibleResultCount = lastResult - firstResult + 1
        local visibleColumns = math.min(2, visibleResultCount)
        local visibleRows = math.ceil(visibleResultCount / 2)
        local borderWidth = 20 + tileWidth + ((visibleColumns - 1) * columnWidth)
        local borderHeight = 20 + tileHeight + ((visibleRows - 1) * rowHeight)

        table.insert(graphics, {
            Type = "GroupBox",
            Position = { 14,14 },
            Size = {borderWidth,borderHeight},
            StrokeColor = "black",
            StrokeWidth = 2,
            CornerRadius = 8,
        })

        for i = firstResult, lastResult do
            local slot = i - firstResult
            local column = slot % 2
            local row = math.floor(slot / 2)
            local x = resultStartX + (column * columnWidth)
            local y = resultStartY + (row * rowHeight)

            layout["favicon " .. i] =
            {
                PrettyName = string.format("Result %i Favicon", i),
                Position = { x, y },
                Size = { 60,tileHeight },
                Style = "Media",
                Color = { 255,255,255,255 },
                CornerRadius = 8,
                ZOrder = 1,
            }
            layout["Name " .. i] =
            {
                PrettyName = string.format("Result %i Name", i),
                Position = { x + 68, y },
                Size = { 180,tileHeight },
                Style = "Text",
                WordWrap = true,
                TextFontSize = 15,
                Color = { 0,0,0,0 },
                TextColor = { 0,0,0 },
                HTextAlign = "Center",
                VTextAlign = "Center",
                CornerRadius = 8,
                StrokeWidth = 1,
                ZOrder = 1,
            }
            layout["SelectBtn " .. i] =
            {
                PrettyName = string.format("Select Result %i", i),
                Position = { x, y },
                Size = { tileWidth,tileHeight },
                Style = "Button",
                ButtonVisualStyle = "Flat",
                Legend = "",
                Color = { 0,0,0,0 },
                OffColor = { 0,0,0,0 },
                StrokeColor = { 0,0,0,0 },
                UnlinkOffColor = true,
                StrokeWidth = 0,
                CornerRadius = 8,
                ZOrder = 2,
            }
        end
    end

    return layout, graphics
end

---------------------------- Other Plugin Functions ---------------------------

function GetPins(props)
	local pins = {
        {
            Name = "Channel 1",
            Direction = "output",
        },
        {
            Name = "Channel 2",
            Direction = "output",
        }
    }
  
	return pins
end
function GetPages(props)
    local pages = {
        { name = "Search" }
    }

    if props["Enable Favicon Pages"].Value then
        local resultPageCount = math.ceil(props["Result Count"].Value / RESULTS_PER_PAGE)
        for page = 1, resultPageCount do
            table.insert(pages, { name = "Results " .. page })
        end
    end

    table.insert(pages, { name = "Presets" })
    return pages
end
function GetComponents(props)
	local components = {
        {
            Name = "_Media_Stream_Receiver",
            -- Q-SYS internal component type for Media Stream Receiver.
            Type = "URL_receiver",
            Properties = {
                ["mode"] = "Stereo",
                ["name"] = props["Name"].Value,
                ["location"] = props["Location"].Value,
            }
        }
    }

	return components
end

function GetWiring(props)
	local wiring = {
        {
            "_Media_Stream_Receiver Channel 1", "Channel 1"
        },
        {
            "_Media_Stream_Receiver Channel 2", "Channel 2"
        }
    }
  
	return wiring
end

------------------------------ Local Functions --------------------------------
function HEXtoDEC(hex)
	hex = string.upper(hex)
	local b1 = string.byte(string.sub(hex, 1, 1))
	local b2 = string.byte(string.sub(hex, 2, 2))
  
	return( (b1<=57 and b1-48 or b1-55)*16 + (b2<=57 and b2-48 or b2-55) )
end

function ConvertColor(c)
	local t = {}
	t[1] = HEXtoDEC(string.sub(c,2,3))
	t[2] = HEXtoDEC(string.sub(c,4,5))
	t[3] = HEXtoDEC(string.sub(c,6,7))
	return t
end

if Controls then
rapidjson = require("rapidjson")

strSearch = Controls.StrSearch
stations = {}
searchRequestId = 0
faviconUpdateIds = {}
local currentStation = nil
local stationRevision = 0
local presets = {}
local selectedPreset = 1
local presetCount = Properties["Preset Count"].Value
RESULT_COUNT = #Controls.favicon

DEFAULT_FAVICON = "https://i.postimg.cc/D0K9R9C9/white-leeg.jpg"
FALLBACK_FAVICON = "https://i.postimg.cc/ZYsFzy7J/radio.png"

-- GetComponents exposes embedded components in the runtime global table.
selectedreceiver = _G["_Media_Stream_Receiver"]

function updateReceiverStatus()
  if not selectedreceiver then
    Controls.ReceiverStatus.Value = 4
    Controls.ReceiverStatus.String = "Embedded receiver unavailable"
    return
  end

  local receiverStatus = selectedreceiver["status"]
  if not receiverStatus then
    Controls.ReceiverStatus.Value = 2
    Controls.ReceiverStatus.String = "Receiver status control unavailable"
    return
  end

  Controls.ReceiverStatus.Value = receiverStatus.Value
  Controls.ReceiverStatus.String = receiverStatus.String
end

if not selectedreceiver then
  print("Embedded Media Stream Receiver is unavailable")
elseif not selectedreceiver["url"] then
  print("Embedded Media Stream Receiver has no 'url' control")
end

if selectedreceiver and selectedreceiver["status"] then
  selectedreceiver["status"].EventHandler = updateReceiverStatus
end

updateReceiverStatus()

local receiverChannelBindings = {
  { Name = "channel.1.gain", Writable = true },
  { Name = "channel.1.invert", Writable = true, Boolean = true },
  { Name = "channel.1.mute", Writable = true, Boolean = true },
  { Name = "channel.1.peak.level" },
  { Name = "channel.2.gain", Writable = true },
  { Name = "channel.2.invert", Writable = true, Boolean = true },
  { Name = "channel.2.mute", Writable = true, Boolean = true },
  { Name = "channel.2.peak.level" },
}

for _, item in ipairs(receiverChannelBindings) do
  local binding = item
  local pluginControl = Controls[binding.Name]
  local receiverControl = selectedreceiver and selectedreceiver[binding.Name]

  if not pluginControl or not receiverControl then
    print("Cannot bind embedded receiver control:", binding.Name)
  else
    local function updatePluginControl(source)
      if binding.Boolean then
        pluginControl.Boolean = source.Boolean
      else
        pluginControl.Value = source.Value
      end
    end

    receiverControl.EventHandler = updatePluginControl
    updatePluginControl(receiverControl)

    if binding.Writable then
      pluginControl.EventHandler = function(source)
        if binding.Boolean then
          receiverControl.Boolean = source.Boolean
        else
          receiverControl.Value = source.Value
        end
      end
    end
  end
end

local InterfaceLookup = {}
local foundInterfaces = {
  ["LAN A"] = false,
  ["LAN B"] = false
}
local interfaceChoices = {}

for _, item in ipairs(Network.Interfaces() or {}) do
  if item.Interface then
    foundInterfaces[item.Interface] = item.Address or false
  end
end

local function addInterfaceChoice(name)
  local address = foundInterfaces[name]
  local text

  if address and address ~= "" then
    text = name .. " (" .. address .. ")"
  else
    text = name .. " (no link)"
  end

  table.insert(interfaceChoices, text)
  InterfaceLookup[text] = {
    Name = name,
    Address = address or nil
  }
end

addInterfaceChoice("LAN A")
addInterfaceChoice("LAN B")

local additionalInterfaceNames = {}
for name, _ in pairs(foundInterfaces) do
  if name ~= "LAN A" and name ~= "LAN B" then
    table.insert(additionalInterfaceNames, name)
  end
end
table.sort(additionalInterfaceNames)

for _, name in ipairs(additionalInterfaceNames) do
  addInterfaceChoice(name)
end

Controls.interface.Choices = interfaceChoices

local function syncInterfaceControl()
  local receiverInterface = selectedreceiver and selectedreceiver["interface"]

  if receiverInterface then
    local currentName = receiverInterface.String
    for text, interface in pairs(InterfaceLookup) do
      if interface.Name == currentName then
        Controls.interface.String = text
        return
      end
    end
  end

  -- LAN A is the default when the receiver has no matching saved interface.
  for text, interface in pairs(InterfaceLookup) do
    if interface.Name == "LAN A" then
      Controls.interface.String = text
      if receiverInterface then
        receiverInterface.String = "LAN A"
      end
      return
    end
  end
end

Controls.interface.EventHandler = function(ctrl)
  local interface = InterfaceLookup[ctrl.String]
  if not interface then
    return
  end

  print("Interface:", interface.Name)
  print("IP:", interface.Address or "No link")

  if not selectedreceiver or not selectedreceiver["interface"] then
    print("Cannot set interface: embedded Media Stream Receiver interface control is unavailable")
    return
  end

  -- The receiver expects the interface name, not the UI label containing its IP.
  selectedreceiver["interface"].String = interface.Name
end

syncInterfaceControl()

function imageControlString(url)
  return rapidjson.encode({
    Protocol = "Image",
    URLs = {url},
    ImageTimeSeconds = 10.0
  })
end

function cacheBustUrl(url)
    if not url or url == "" then return url end

    local sep = "?"
    if string.find(url, "?", 1, true) then
        sep = "&"
    end

    return url .. sep .. "qsys_t=" .. tostring(os.time()) .. "_" .. tostring(math.random(100000,999999))
end

function setFaviconControl(index, url)
  faviconUpdateIds[index] = (faviconUpdateIds[index] or 0) + 1
  local updateId = faviconUpdateIds[index]

  Controls.favicon[index].IsInvisible = true
  Controls.Name[index].IsInvisible = true
  if Controls.SelectBtn and Controls.SelectBtn[index] then
    Controls.SelectBtn[index].IsInvisible = true
  end

  if url == DEFAULT_FAVICON then
    Controls.favicon[index].String = imageControlString(cacheBustUrl(url))
    return
  end

  Timer.CallAfter(function()
    if faviconUpdateIds[index] == updateId then
      Controls.favicon[index].String = imageControlString(cacheBustUrl(url))

      Timer.CallAfter(function()
        if faviconUpdateIds[index] == updateId then
          Controls.favicon[index].IsInvisible = false
          Controls.Name[index].IsInvisible = false
          if Controls.SelectBtn and Controls.SelectBtn[index] then
            Controls.SelectBtn[index].IsInvisible = false
          end
        end
      end, 0.2)
    end
  end, 0.2)
end

function setNowPlayingFavicon(url)
  if not Controls.NowPlayingFavicon then
    return
  end

  local displayUrl = cacheBustUrl(url or FALLBACK_FAVICON)
  Controls.NowPlayingFavicon.String = imageControlString(displayUrl)
end

function funcResetUI()
  for i, _ in pairs(Controls.favicon) do
    setFaviconControl(i, DEFAULT_FAVICON)
  end

  for i, _ in pairs(Controls.Name) do
          Controls.Name[i].String = ""
  end
end

function formatStationName(name)
  if not name or name == "" then
    return ""
  end

  if string.len(name) <= 100 then
    return name
  end

  return string.sub(name, 1, 97) .. "..."
end

function tuneStation(station)
  if not station or type(station.url) ~= "string" or station.url == "" then
    return false
  end
  if not selectedreceiver or not selectedreceiver["url"] then
    print("Cannot tune station: embedded Media Stream Receiver is unavailable")
    return false
  end

  selectedreceiver["url"].String = station.url
  if selectedreceiver["enable"] then
    selectedreceiver["enable"].Boolean = true
  end
  stationRevision = stationRevision + 1
  currentStation = { url = station.url, name = station.name or station.url, favicon = station.favicon or "" }
  Controls.NowPlaying.String = formatStationName(currentStation.name)
  setNowPlayingFavicon(station.displayFavicon or convertFavicon(currentStation.favicon))
  return true
end

function selectStation(index)
  if tuneStation(stations[index]) then
    Controls.StrSearchResult.Value = index
  end
end

function convertFavicon(url)
    if not url or url == "" then
        return FALLBACK_FAVICON
    end

    url = string.match(url, "^%s*(.-)%s*$")
    if url == "" then
        return FALLBACK_FAVICON
    end

    return "https://images.weserv.nl/?url="
        .. urlEncode(string.gsub(url, "^https?://", ""))
        .. "&output=png"
        .. "&default="
        .. urlEncode(FALLBACK_FAVICON)
        .. "&n="
        .. tostring(os.time())
        .. tostring(math.random(1000,9999))
end

local function refreshPresets()
    local choices = {}
    for i = 1, presetCount do
        local preset = presets[tostring(i)]
        choices[i] = string.format("%02d - %s", i, preset and formatStationName(preset.name) or "Empty")
    end
    Controls.PresetList.Choices = choices
    Controls.PresetList.String = choices[selectedPreset]
    local preset = presets[tostring(selectedPreset)]
    Controls.PresetName.String = preset and preset.name or "Empty preset"
    Controls.PresetUrl.String = preset and preset.url or ""
    Controls.PresetFavicon.String = preset and imageControlString(convertFavicon(preset.favicon)) or ""
    Controls.PresetRecall.IsDisabled = preset == nil
    Controls.PresetDelete.IsDisabled = preset == nil
end

local function loadPresets()
    presets = {}
    local data = Controls.PresetData.String
    if data ~= "" then
        local ok, saved = pcall(rapidjson.decode, data)
        if not ok or type(saved) ~= "table" then
            Controls.PresetStatus.String = "Saved preset data could not be read."
            refreshPresets()
            return
        end
        for key, preset in pairs(saved) do
            local slot = tonumber(key)
            if slot and slot >= 1 and slot <= 40 and slot == math.floor(slot)
                and type(preset) == "table" and type(preset.url) == "string" and preset.url ~= ""
                and type(preset.name) == "string" and type(preset.favicon) == "string" then
                presets[tostring(slot)] = { url = preset.url, name = preset.name, favicon = preset.favicon }
            end
        end
    end
    refreshPresets()
end

Controls.PresetList.EventHandler = function(ctrl)
    for i, choice in ipairs(ctrl.Choices) do
        if ctrl.String == choice then
            selectedPreset = i
            Controls.PresetStatus.String = ""
            refreshPresets()
            return
        end
    end
end

Controls.PresetSave.EventHandler = function()
    local receiverUrl = selectedreceiver and selectedreceiver["url"]
    if not receiverUrl or receiverUrl.String == "" then
        Controls.PresetStatus.String = "Play a station before saving a preset."
        return
    end
    if not currentStation or currentStation.url ~= receiverUrl.String then
        Controls.PresetStatus.String = "Station details are unavailable. Select the station in Search first."
        return
    end
    presets[tostring(selectedPreset)] = {
        url = currentStation.url, name = currentStation.name, favicon = currentStation.favicon
    }
    Controls.PresetData.String = rapidjson.encode(presets)
    refreshPresets()
    Controls.PresetStatus.String = "Saved preset " .. selectedPreset .. ": " .. currentStation.name
end

Controls.PresetRecall.EventHandler = function()
    local preset = presets[tostring(selectedPreset)]
    if not preset then
        Controls.PresetStatus.String = "This preset is empty."
    elseif tuneStation(preset) then
        Controls.PresetStatus.String = "Recalled preset " .. selectedPreset .. ": " .. preset.name
    else
        Controls.PresetStatus.String = "Cannot recall: embedded receiver unavailable."
    end
end

Controls.PresetDelete.EventHandler = function()
    presets[tostring(selectedPreset)] = nil
    Controls.PresetData.String = rapidjson.encode(presets)
    refreshPresets()
    Controls.PresetStatus.String = "Deleted preset " .. selectedPreset .. "."
end

Controls.PresetData.EventHandler = loadPresets
Controls.PresetStatus.String = "Save replaces the selected slot. Delete clears it without stopping playback."

function funcGetRadio(requestId, tbl, code, data, err, headers)
    print(string.format(
        "HTTP response from '%s': Return Code=%i; Error=%s",
        tbl.Url, code, err or "None"
    ))

    if requestId ~= searchRequestId then
        print("Ignoring stale radio search response")
        return
    end

    if code ~= 200 then
        Timer.CallAfter(funcSearchRadio, 1)
        return
    end

    local radios = rapidjson.decode(data)
    if not radios then return end

    local stationMap = {}
    stations = {}
    local choices = {}

    for _, station in ipairs(radios) do
        local name = station.name or "Unknown"
        local url  = station.url_resolved or station.url
        local clickcount = station.clickcount or 0
        local favicon = station.favicon or ""
        local codec = string.upper(station.codec or "")

        local key = string.lower(name)

        -- Only keep playable MP3/MPEG stations
        if codec == "MP3" or codec == "MPEG" then
            if not stationMap[key] or clickcount > stationMap[key].clickcount then
                stationMap[key] = {
                    name = name,
                    url = url,
                    clickcount = clickcount,
                    favicon = favicon or ""
                }
            end
        end
    end

    -- Convert map to array, only stations with playable URL
    for _, s in pairs(stationMap) do
        if s.url then
            table.insert(stations, s)
        end
    end

    table.sort(stations, function(a, b)
        return a.clickcount > b.clickcount
    end)

    -- Clear previous result images
    funcResetUI()

    local faviconUrls = {}

    -- Build UI choices and names first
    for i, s in ipairs(stations) do
        if i <= RESULT_COUNT then
          s.displayName = formatStationName(s.name)
          choices[i] = s.displayName

          if s.favicon and s.favicon ~= "" then
            faviconUrls[i] = convertFavicon(s.favicon)
          else
            faviconUrls[i] = FALLBACK_FAVICON
          end
          s.displayFavicon = faviconUrls[i]

          if s.displayName and s.displayName ~= "" then
            Controls.Name[i].String = s.displayName
            Controls.Name[i].IsInvisible = false
            if Controls.SelectBtn and Controls.SelectBtn[i] then
                Controls.SelectBtn[i].IsInvisible = false
            end
          else
            Controls.Name[i].String = ""
          end
        end
    end

    Controls.StrSearchResult.Choices = choices

    if #choices > 0 then
        Controls.StrSearchResult.Value = 1
    end

    -- Put favicon URLs into the controls last, after results are filtered and named
    for i, favicon in ipairs(faviconUrls) do
        local raw = stations[i].favicon
        if raw and raw ~= "" then
            print(string.format("Result %02d favicon for '%s': raw=%s display=%s", i, stations[i].name or "", raw, favicon))
        else
            print(string.format("Result %02d favicon for '%s': raw=None display=%s", i, stations[i].name or "", favicon))
        end

        setFaviconControl(i, favicon)
    end
end

countryCodeByName = {}

function funcSearchRadio()
    searchRequestId = searchRequestId + 1
    local requestId = searchRequestId

    local choices = {"Searching..."}
    Controls.StrSearchResult.Choices = choices

    local search = string.gsub(strSearch.String, " ", "+")
    local countryCode = selectedCountryCode or "BE"
    local countryFilter = ""
    if countryCode and countryCode ~= "" then
        countryFilter = "&countrycode=" .. countryCode
    end

    local url = string.format(
        "https://de1.api.radio-browser.info/json/stations/search?name=%s%s&limit=200&hidebroken=true&order=name",
        search,
        countryFilter
    )

    HttpClient.Get{
        Url = url,
        Timeout = 30,
        EventHandler = function(tbl, code, data, err, headers)
            funcGetRadio(requestId, tbl, code, data, err, headers)
        end
    }
end

function funcParceCountryCodes(tbl, code, data, err, headers)
    print(string.format(
        "HTTP response from '%s': Return Code=%i; Error=%s",
        tbl.Url, code, err or "None"
    ))

    local countries = rapidjson.decode(data)

    local choices = {}
    countryCodeByName = {}

    for _, country in ipairs(countries) do
        if country.name and country.iso_3166_1 then
            table.insert(choices, country.name)
            countryCodeByName[country.name] = country.iso_3166_1
        end
    end

    table.sort(choices)
    table.insert(choices, 1, "All")
    countryCodeByName["All"] = ""

    Controls.Country_Code.Choices = choices
    if countryCodeByName[Controls.Country_Code.String] == nil then
        Controls.Country_Code.String = "All"
    end
    selectedCountryCode = countryCodeByName[Controls.Country_Code.String]
end

function funcGetCountryCodes()
  url = "https://de1.api.radio-browser.info/json/countries"
  HttpClient.Get{Url = url, Timeout = 30, EventHandler = funcParceCountryCodes}
end

strSearch.EventHandler = function()
  funcResetUI()
  strSearch.String = string.gsub(strSearch.String, "[\r\n]", "")
  funcSearchRadio()
end

Controls.Country_Code.EventHandler = function(ctrl)
    local selectedCountryName = ctrl.String

    selectedCountryCode = countryCodeByName[selectedCountryName]

    print("Selected country: " .. tostring(selectedCountryName))
    print("Selected country code: " .. tostring(selectedCountryCode))

    searchRequestId = searchRequestId + 1
    Controls.StrSearch.String = ""
    Controls.StrSearchResult.Choices = {}
    funcResetUI()
end

Controls.StrSearchResult.EventHandler = function()
  for i,v in ipairs(Controls.StrSearchResult.Choices) do
    if stations[i] and Controls.StrSearchResult.String == stations[i].displayName then
      selectStation(i)
    end
  end
end

if Controls.SelectBtn then
  for i, btn in ipairs(Controls.SelectBtn) do
    btn.EventHandler = function()
      selectStation(i)
    end
  end
end

function urlEncode(str)
    if not str then return "" end

    return string.gsub(str, "([^%w%-_%.~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
end

function funcRestoreNowPlaying(tbl, code, data, err, headers, streamUrl, revision)
    print(string.format(
        "Restore response: Return Code=%i; Error=%s",
        code,
        err or "None"
    ))

    if code ~= 200 or revision ~= stationRevision or not selectedreceiver
        or not selectedreceiver["url"] or selectedreceiver["url"].String ~= streamUrl then
        return
    end

    local stations = rapidjson.decode(data)

    if stations and stations[1] and stations[1].name then
        currentStation = { url = streamUrl, name = stations[1].name, favicon = stations[1].favicon or "" }
        Controls.NowPlaying.String = formatStationName(stations[1].name)
        setNowPlayingFavicon(convertFavicon(stations[1].favicon))
        print("Restored station: " .. stations[1].name)
    end
end

function funcGetCurrentStation()
    if not selectedreceiver or not selectedreceiver["url"] then
        return
    end

    local streamUrl = selectedreceiver["url"].String

    if streamUrl == nil or streamUrl == "" then
        return
    end

    local lookupUrl =
        "https://de1.api.radio-browser.info/json/stations/byurl?url="
        .. urlEncode(streamUrl)

    print("Looking up station: " .. lookupUrl)

    local revision = stationRevision
    HttpClient.Get{
        Url = lookupUrl,
        Timeout = 10,
        EventHandler = function(tbl, code, data, err, headers)
            funcRestoreNowPlaying(tbl, code, data, err, headers, streamUrl, revision)
        end
    }
end

loadPresets()

Controls.StrSearch.String = ""

choices = {}
Controls.StrSearchResult.Choices = choices

funcGetCountryCodes()

Timer.CallAfter(function()
    funcGetCurrentStation()
end, 2)

funcResetUI()

end -- if Controls
