                PrettyName = "Presets~Favicon", Position = { 34,350 }, Size = { 100,100 },
                Style = "Media", CornerRadius = 8,
            }
        end
        layout["PresetUrl"] = {
            PrettyName = "Presets~Stream URL",
            Position = faviconPagesEnabled and { 144,415 } or { 34,415 },
            Size = faviconPagesEnabled and { 409,35 } or { 519,35 },
            Style = "Text", TextFontSize = 12,
        }
        for i, action in ipairs({ "Save", "Recall", "Delete" }) do
            layout["Preset" .. action] = {
                PrettyName = "Presets~" .. action, Position = { 34 + (i - 1) * 178,470 },
                Size = { 163,40 }, Style = "Button", Legend = action, CornerRadius = 8,
            }
        end
        layout["PresetStatus"] = {
            PrettyName = "Presets~Status", Position = { 34,530 }, Size = { 519,60 },
            Style = "Text", TextFontSize = 14, WordWrap = true,
