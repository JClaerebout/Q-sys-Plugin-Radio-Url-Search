------------------------------ Local Functions --------------------------------
function HEXtoDEC(hex)
	hex = string.upper(hex)
	local b1 = string.byte(string.sub(hex, 1, 1))
	local b2 = string.byte(string.sub(hex, 2, 2))
  
	return( (b1<=57 and b1-48 or b1-55)*16 + (b2<=57 and b2-48 or b2-55) )
end

function ConvertColor(c)
	local t = {}
	t[1] = HEXtoDEC(string.sub(c,2,3))
	t[2] = HEXtoDEC(string.sub(c,4,5))
	t[3] = HEXtoDEC(string.sub(c,6,7))
	return t
end

function funcGetRadio(tbl, code, data, err, headers)
    print(string.format(
        "HTTP response from '%s': Return Code=%i; Error=%s",
        tbl.Url, code, err or "None"
    ))

    if code ~= 200 then
        Timer.CallAfter(funcSearchRadio, 1)
        return
    end

    local radios = rapidjson.decode(data)
    if not radios then return end

    local stationMap = {}   -- key = normalized name
    stations = {}           -- final array
    local choices = {}

    -- Deduplicate by name, keep highest clickcount
    for _, station in ipairs(radios) do
        local name = station.name or "Unknown"
        local url  = station.url_resolved or station.url
        local clickcount = station.clickcount or 0

        -- normalize name for comparison
        local key = string.lower(name)

        if not stationMap[key] or clickcount > stationMap[key].clickcount then
            stationMap[key] = {
                name = name,
                url  = url,
                clickcount = clickcount
            }
        end
    end

    -- Convert map → array
    for _, s in pairs(stationMap) do
        table.insert(stations, s)
    end

    -- Optional: sort by popularity
    table.sort(stations, function(a, b)
        return a.clickcount > b.clickcount
    end)

    -- Build UI choices
    for i, s in ipairs(stations) do
        choices[i] = s.name
    end

    -- Push to ListBox / ComboBox
    Controls.StrSearchResult.Choices = choices

    if #choices > 0 then
        Controls.StrSearchResult.Value = 1
    end
end

countryCodeByName = {}

function funcSearchRadio()
    local choices = {"Searching..."}
    Controls.StrSearchResult.Choices = choices

    local search = string.gsub(strSearch.String, " ", "+")
    local countryCode = selectedCountryCode or "BE"

    local url = string.format(
        "https://de1.api.radio-browser.info/json/stations/search?name=%s&countrycode=%s&limit=20&hidebroken=true&order=name",
        search,
        countryCode
    )

    HttpClient.Get{Url = url, Timeout = 10, EventHandler = funcGetRadio}
end

function funcParceCountryCodes(tbl, code, data, err, headers)
    print(string.format(
        "HTTP response from '%s': Return Code=%i; Error=%s",
        tbl.Url, code, err or "None"
    ))

    local countries = rapidjson.decode(data)

    local choices = {}

    for _, country in ipairs(countries) do
        if country.name and country.iso_3166_1 then
            table.insert(choices, country.name)
            countryCodeByName[country.name] = country.iso_3166_1
        end
    end

    table.sort(choices)

    Controls.Country_Code.Choices = choices

    selectedCountryCode = countryCodeByName[Controls.Country_Code.String]
end

function funcGetCountryCodes()
  url = "https://de1.api.radio-browser.info/json/countries"
  HttpClient.Get{Url = url, Timeout = 30, EventHandler = funcParceCountryCodes}
end 

function urlEncode(str)
    if not str then return "" end

    return string.gsub(str, "([^%w%-_%.~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
end

function funcRestoreNowPlaying(tbl, code, data, err, headers)
    print(string.format(
        "Restore response: Return Code=%i; Error=%s",
        code,
        err or "None"
    ))

    if code ~= 200 then
        return
    end

    local stations = rapidjson.decode(data)

    if stations and stations[1] and stations[1].name then
        Controls.NowPlaying.String = stations[1].name
        print("Restored station: " .. stations[1].name)
    end
end

function funcGetCurrentStation()
    if not selectedreceiver or not selectedreceiver["url"] then
        return
    end

    local streamUrl = selectedreceiver["url"].String

    if streamUrl == nil or streamUrl == "" then
        return
    end

    local lookupUrl =
        "https://de1.api.radio-browser.info/json/stations/byurl?url="
        .. urlEncode(streamUrl)

    print("Looking up station: " .. lookupUrl)

    HttpClient.Get{
        Url = lookupUrl,
        Timeout = 10,
        EventHandler = funcRestoreNowPlaying
    }
end

