--------------------------------- Properties ----------------------------------
function GetProperties()
    local props = {
        {
            Name = "Name",
            Type = "string",
            Value = "Radio Url Search"
        },
        {
            Name = "Location",
            Type = "string",
            Value = "Default Location"
        },
        {
            Name = "Result Count",
            Type = "integer",
            Value = 20,
            Min = 1,
            Max = 40,
        },
        {
            Name = "Preset Count",
            Type = "integer",
            Value = 10,
            Min = 1,
            Max = 40,
        },
        {
            Name = "Enable Logo Pages",
            Type = "boolean",
            Value = true,
        },
    }

    return props
end

function RectifyProperties(props)
    return props
end

------------------------- Plugin Block Name and Color -------------------------
function GetPrettyName(props)
    return PluginInfo["Name"] .. " v" .. PluginInfo["Version"]
end

function GetColor(props)
	return ConvertColor("#cccccc")
end

---------------------------------- Controls -----------------------------------
function GetControls(props)
    local ctls = { }

    -- Editable text controls retain saved preset data as part of the design.
    table.insert(ctls, { Name = "PresetData", ControlType = "Text", UserPin = false })
    table.insert(ctls, { Name = "PresetList", ControlType = "Text", UserPin = false })
    for _, name in ipairs({ "PresetName", "PresetUrl", "PresetStatus" }) do
        table.insert(ctls, {
            Name = name, ControlType = "Indicator", IndicatorType = "Text", UserPin = false
        })
    end
    table.insert(ctls, {
        Name = "PresetFavicon", ControlType = "Button", ButtonType = "Momentary", UserPin = false
    })
    for _, action in ipairs({ "Save", "Recall", "Delete" }) do
        table.insert(ctls, {
            Name = "Preset" .. action, ControlType = "Button", ButtonType = "Trigger", UserPin = false
        })
    end

	if ENABLE_CODE_PIN then
		table.insert(ctls, {
            Name = "code",
            ControlType = "Text",
            Count = 1,
            PinStyle = "Input",
            UserPin = true
        })
	end

    table.insert(ctls, {
        Name = "StrSearch",
        ControlType = "Text",
        Count = 1,
        PinStyle = "Input",
        UserPin = true
    })

    table.insert(ctls, {
        Name = "StrSearchResult",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "Country_Code",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "ReceiverStatus",
        ControlType = "Indicator",
        IndicatorType = "Status",
        Count = 1,
        PinStyle = "Output",
        UserPin = true
    })

    table.insert(ctls, {
        Name = "enable",
        ControlType = "Button",
        ButtonType = "Toggle",
        Count = 1,
        PinStyle = "Both",
        UserPin = true
    })

    table.insert(ctls, {
        Name = "interface",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "NowPlaying",
        ControlType = "Indicator",
        IndicatorType = "Text",
        Count = 1,
        PinStyle = "Output",
        UserPin = true
    })

    table.insert(ctls, {
        Name = "SelectBtn",
        ControlType = "Button",
        ButtonType = "Trigger",
        Count = props["Result Count"].Value,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "ResultName",
        ControlType = "Button",
        ButtonType = "Trigger",
        Count = props["Result Count"].Value,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "StationLogo",
        ControlType = "Button",
        ButtonType = "Momentary",
        Count = 1,
        UserPin = false
    })

    for channel = 1, 2 do
        local prefix = "channel." .. channel .. "."

        table.insert(ctls, {
            Name = prefix .. "gain",
            ControlType = "Knob",
            ControlUnit = "dB",
            Min = -100,
            Max = 20,
            DefaultValue = 0,
            PinStyle = "Both",
            UserPin = true
        })

        table.insert(ctls, {
            Name = prefix .. "invert",
            ControlType = "Button",
            ButtonType = "Toggle",
            PinStyle = "Both",
            UserPin = true
        })

        table.insert(ctls, {
            Name = prefix .. "mute",
            ControlType = "Button",
            ButtonType = "Toggle",
            PinStyle = "Both",
            UserPin = true
        })

        table.insert(ctls, {
            Name = prefix .. "peak.level",
            ControlType = "Indicator",
            IndicatorType = "Meter",
            ControlUnit = "dB",
            Min = -120,
            Max = 43,
            PinStyle = "Output",
            UserPin = true
        })
    end

    for _, name in ipairs({ "StreamTitle", "StreamUrl", "MetadataStatus" }) do
        table.insert(ctls, { Name = name, ControlType = "Indicator", IndicatorType = "Text",
            Count = 1, PinStyle = "Output", UserPin = true })
    end
    return ctls
end

------------------------------- Control Layout --------------------------------
function GetControlLayout(props)
    local layout = { }
    local graphics = { }
    local currentPage = props["page_index"].Value
    local resultCount = props["Result Count"].Value
    local logoPagesEnabled = props["Enable Logo Pages"].Value
    local presetPage = 2 + (logoPagesEnabled and math.ceil(resultCount / RESULTS_PER_PAGE) or 0)

    layout["PresetData"] = { Style = "None" }

    if ENABLE_CODE_PIN then
        layout["code"] =
        {
            PrettyName = "Code",
            Style = "None"
        }
    end

    -- Compact component layout with aligned rows and light group borders.
    local function label(text, x, y, width, height, align)
        table.insert(graphics, {
            Type = "Label", Text = text, Position = { x,y }, Size = { width,height },
            TextSize = 12, HTextAlign = align or "Left", VTextAlign = "Center",
        })
    end

    local function group(title, x, y, width, height)
        table.insert(graphics, {
            Type = "GroupBox", Position = { x,y }, Size = { width,height },
            StrokeColor = "#999999", StrokeWidth = 1, CornerRadius = 5,
        })
        label(title, x + 10, y + 6, width - 20, 18)
    end

    local function control(name, prettyName, style, x, y, width, height, options)
        local item = {
            PrettyName = prettyName, Style = style,
            Position = { x,y }, Size = { width,height },
            TextFontSize = 12, CornerRadius = 0, HTextAlign = "Center", VTextAlign = "Center",
        }
        for key, value in pairs(options or {}) do item[key] = value end
        layout[name] = item
    end

    if currentPage == 1 then
        group("Radio Search", 8, 8, 340, 404)
        label("Status", 18, 36, 68, 22)
        control("ReceiverStatus", "Media Stream Receiver Status", "Text", 90, 36, 248, 22)
        label("Interface", 18, 64, 68, 22)
        control("interface", "Media Stream Receiver Interface", "ComboBox", 90, 64, 248, 22)
        label("Country", 18, 100, 68, 22)
        control("Country_Code", "Country Select", "ComboBox", 90, 100, 248, 22)
        label("Station", 18, 128, 68, 22)
        control("StrSearch", "String Search", "Text", 90, 128, 248, 22)
        label("Results", 18, 162, 320, 18)
        control("StrSearchResult", "String Search Result", "ListBox", 18, 184, 320, 100)
        label("Now Playing", 18, 290, 320, 18)
        -- The square logo spans both text rows; leave an 8px column gap.
        control("NowPlaying", "Now Playing", "Text",
            logoPagesEnabled and 90 or 18, 310, logoPagesEnabled and 248 or 320, 24,
            { WordWrap = true })
        if logoPagesEnabled then
            control("StationLogo", "Now Playing Logo", "Button", 18, 310, 64, 64,
                { Color = { 0,0,0,0 } })
        end

        control("StreamTitle", "ICY~Song Title", "Text",
            logoPagesEnabled and 90 or 18, 338, logoPagesEnabled and 248 or 320, 36,
            { WordWrap = true })
        control("MetadataStatus", "ICY~Status", "Text", 18, 380, 320, 22)

        group("Receiver", 356, 8, 196, 404)
        control("enable", "Media Stream Receiver Enable", "Button", 368, 36, 172, 24, {
            ButtonStyle = "Toggle", Legend = "Enable", HTextAlign = "Center",
            OffColor = { 100,100,100 }, Color = { 0,180,0 }, UnlinkOffColor = true,
        })
        label("Peak Level", 368, 108, 54, 20)
        label("(dBFS)", 368, 128, 54, 20)
        label("Invert", 368, 246, 54, 22)
        label("Mute", 368, 274, 54, 22)
        label("Gain", 368, 312, 54, 22)
        label("(dB)", 368, 334, 54, 20)
        for channel = 1, 2 do
            local prefix = "channel." .. channel .. "."
            local x = 428 + ((channel - 1) * 60)
            label(tostring(channel), x, 76, 48, 20, "Center")
            control(prefix .. "peak.level", "Channel " .. channel .. "~Peak Level",
                "Meter", x, 100, 48, 132)
            control(prefix .. "invert", "Channel " .. channel .. "~Invert",
                "Button", x, 246, 48, 22, {
                    ButtonStyle = "Toggle", HTextAlign = "Center",
                    OffColor = { 125,122,52 }, Color = { 255,246,96 }, UnlinkOffColor = true,
                })
            control(prefix .. "mute", "Channel " .. channel .. "~Mute",
                "Button", x, 274, 48, 22, {
                    ButtonStyle = "Toggle", HTextAlign = "Center",
                    OffColor = { 105,16,25 }, Color = { 215,27,43 }, UnlinkOffColor = true,
                })
            control(prefix .. "gain", "Channel " .. channel .. "~Gain",
                "Knob", x, 310, 48, 48, { ShowTextbox = true, HTextAlign = "Center" })
        end
    elseif currentPage == presetPage then
        group("Station Presets", 8, 8, 544, 404)
        label("Select a slot. Save stores the currently playing station.", 18, 34, 524, 20)
        control("PresetList", "Presets~Slot", "ListBox", 18, 62, 524, 176)
        label("Station", 18, 248, 524, 18)
        control("PresetName", "Presets~Station Name", "Text",
            logoPagesEnabled and 82 or 18, 270, logoPagesEnabled and 460 or 524, 24,
            { WordWrap = true })
        if logoPagesEnabled then
            control("PresetFavicon", "Presets~Logo", "Button", 18, 270, 56, 56)
        end
        control("PresetUrl", "Presets~Stream URL", "Text",
            logoPagesEnabled and 82 or 18, 298, logoPagesEnabled and 460 or 524, 22)
        for i, action in ipairs({ "Save", "Recall", "Delete" }) do
            control("Preset" .. action, "Presets~" .. action, "Button",
                18 + (i - 1) * 178, 332, 168, 26,
                { Legend = action, HTextAlign = "Center" })
        end
        control("PresetStatus", "Presets~Status", "Text", 18, 370, 524, 32,
            { WordWrap = true })
    else
        local resultPage = currentPage - 1
        local firstResult = ((resultPage - 1) * RESULTS_PER_PAGE) + 1
        local lastResult = math.min(firstResult + RESULTS_PER_PAGE - 1, resultCount)
        local resultStartX = 18
        local resultStartY = 18
        local columnWidth = 256
        local rowHeight = 64
        local tileWidth = 248
        local tileHeight = 60
        local visibleResultCount = lastResult - firstResult + 1
        local visibleColumns = math.min(2, visibleResultCount)
        local visibleRows = math.ceil(visibleResultCount / 2)
        local borderWidth = 20 + tileWidth + ((visibleColumns - 1) * columnWidth)
        local borderHeight = 20 + tileHeight + ((visibleRows - 1) * rowHeight)

        table.insert(graphics, {
            Type = "GroupBox",
            Position = { 8,8 },
            Size = {borderWidth,borderHeight},
            StrokeColor = "#999999",
            StrokeWidth = 1,
            CornerRadius = 5,
        })

        for i = firstResult, lastResult do
            local slot = i - firstResult
            local column = slot % 2
            local row = math.floor(slot / 2)
            local x = resultStartX + (column * columnWidth)
            local y = resultStartY + (row * rowHeight)

            layout["SelectBtn " .. i] =
            {
                PrettyName = string.format("Select Result %i", i),
                Position = { x, y },
                Size = { tileWidth / 4,tileHeight },
                Style = "Button",
                ButtonVisualStyle = "Flat",
                Legend = "",
                FontSize = 15,
                WordWrap = true,
                HTextAlign = "Center",
                VTextAlign = "Center",
                Color = { 0,0,0,0 },
                OffColor = { 0,0,0,0 },
                StrokeColor = { 0,0,0,0 },
                TextColor = { 0,0,0 },
                UnlinkOffColor = true,
                StrokeWidth = 0,
                CornerRadius = 0,
                ZOrder = 1,
            }

            control("ResultName " .. i, string.format("Result Name %i", i), "Button",
                x + tileWidth / 4, y, tileWidth * 3 / 4, tileHeight, {
                    ButtonStyle = "Trigger", ButtonVisualStyle = "Flat", Legend = "",
                    FontSize = 11, WordWrap = true,
                    -- Inherit theme colors; transparent black can select white contrast text.
                    StrokeWidth = 0,
                })
        end
    end

    return layout, graphics
end

