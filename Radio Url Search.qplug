if Controls then
------------------------------------ Objects ----------------------------------


-------------------------------- Initialization -------------------------------
function Initialize()
	-- Do initialization stuff here
    rapidjson = require("rapidjson")

    strSearch = Controls.StrSearch

    Components = Component.GetComponents()
    URLReceiverComponents = {}
    countryCodeByName = {}

    for key,value in pairs(Components) do
        if value.Type == "URL_receiver" then 
            table.insert(URLReceiverComponents,value.Name)
        end 
    end

    Controls.ReceiverComponent.Choices = URLReceiverComponents

    selectedreceiver =  Component.New(Controls.ReceiverComponent.String)

    Controls.ReceiverComponent.EventHandler = function()
        selectedreceiver =  Component.New(Controls.ReceiverComponent.String)
    end 

    strSearch.EventHandler = function()
        strSearch.String = string.gsub(strSearch.String, "\r\n", "")
        funcSearchRadio()
        if string.find(strSearch.String, "\r") then 
        end 
    end 

    Controls.Country_Code.EventHandler = function(ctrl)
        local selectedCountryName = ctrl.String

        selectedCountryCode = countryCodeByName[selectedCountryName]

        print("Selected country: " .. tostring(selectedCountryName))
        print("Selected country code: " .. tostring(selectedCountryCode))

        Controls.StrSearch.String = ""
        Controls.StrSearchResult.Choices = {}
    end

    Controls.StrSearchResult.EventHandler = function()
        for i,v in ipairs(Controls.StrSearchResult.Choices) do
            if Controls.StrSearchResult.String == stations[i].name then 
                selectedreceiver["url"].String = stations[i].url
                Controls.NowPlaying.String = stations[i].name
            end 
        end
    end

    Controls.StrSearch.String = ""

    choices = {}
    Controls.StrSearchResult.Choices = choices

    funcGetCountryCodes()

    Timer.CallAfter(function()
        funcGetCurrentStation()
    end, 2)

end

local canInitialize = true

-- Check Properties and other stuff for illegal values

if canInitialize then
	print("Initializing")
	Initialize()
	print("Initialization Complete")
else
	print("Not initializing")
end

-- Nothing should be done after this point

