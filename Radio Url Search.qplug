function GetPages(props)
    local pages = {
        { name = "Search" }
    }

    if props["Enable Logo Pages"].Value then
        local resultPageCount = math.ceil(props["Result Count"].Value / RESULTS_PER_PAGE)
        for page = 1, resultPageCount do
            table.insert(pages, { name = "Results " .. page })
        end
    end

    table.insert(pages, { name = "Presets" })
    return pages
end
