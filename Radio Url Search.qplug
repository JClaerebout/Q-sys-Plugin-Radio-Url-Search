	return wiring
end

------------------------------ Local Functions --------------------------------
function HEXtoDEC(hex)
	hex = string.upper(hex)
	local b1 = string.byte(string.sub(hex, 1, 1))
	local b2 = string.byte(string.sub(hex, 2, 2))
  
	return( (b1<=57 and b1-48 or b1-55)*16 + (b2<=57 and b2-48 or b2-55) )
end

function ConvertColor(c)
	local t = {}
	t[1] = HEXtoDEC(string.sub(c,2,3))
	t[2] = HEXtoDEC(string.sub(c,4,5))
	t[3] = HEXtoDEC(string.sub(c,6,7))
	return t
end

if Controls then
rapidjson = require("rapidjson")

strSearch = Controls.StrSearch
stations = {}
searchRequestId = 0
local currentStation = nil
local stationRevision = 0
local presets = {}
local selectedPreset = 1
local presetCount = Properties["Preset Count"].Value
RESULT_COUNT = #Controls.SelectBtn

local EMPTY_RESULT_FAVICON = false

-- GetComponents exposes embedded components in the runtime global table.
selectedreceiver = _G["_Media_Stream_Receiver"]

function updateReceiverStatus()
  if not selectedreceiver then
    Controls.ReceiverStatus.Value = 4
    Controls.ReceiverStatus.String = "Embedded receiver unavailable"
    return
  end

  local receiverStatus = selectedreceiver["status"]
  if not receiverStatus then
    Controls.ReceiverStatus.Value = 2
    Controls.ReceiverStatus.String = "Receiver status control unavailable"
    return
  end

  Controls.ReceiverStatus.Value = receiverStatus.Value
  Controls.ReceiverStatus.String = receiverStatus.String
end

if not selectedreceiver then
  print("Embedded Media Stream Receiver is unavailable")
elseif not selectedreceiver["url"] then
  print("Embedded Media Stream Receiver has no 'url' control")
end

if selectedreceiver and selectedreceiver["status"] then
  selectedreceiver["status"].EventHandler = updateReceiverStatus
end

updateReceiverStatus()

local receiverBindings = {
  { Name = "enable", Writable = true, Boolean = true },
  { Name = "channel.1.gain", Writable = true },
  { Name = "channel.1.invert", Writable = true, Boolean = true },
  { Name = "channel.1.mute", Writable = true, Boolean = true },
  { Name = "channel.1.peak.level" },
  { Name = "channel.2.gain", Writable = true },
  { Name = "channel.2.invert", Writable = true, Boolean = true },
  { Name = "channel.2.mute", Writable = true, Boolean = true },
  { Name = "channel.2.peak.level" },
}

for _, item in ipairs(receiverBindings) do
  local binding = item
  local pluginControl = Controls[binding.Name]
  local receiverControl = selectedreceiver and selectedreceiver[binding.Name]

  if not pluginControl or not receiverControl then
    print("Cannot bind embedded receiver control:", binding.Name)
  else
    local function updatePluginControl(source)
      if binding.Boolean then
        pluginControl.Boolean = source.Boolean
      else
        pluginControl.Value = source.Value
      end
    end

    receiverControl.EventHandler = updatePluginControl
    updatePluginControl(receiverControl)

    if binding.Writable then
      pluginControl.EventHandler = function(source)
        if binding.Boolean then
          receiverControl.Boolean = source.Boolean
        else
          receiverControl.Value = source.Value
        end
      end
    end
  end
end

local InterfaceLookup = {}
local foundInterfaces = {
  ["LAN A"] = false,
  ["LAN B"] = false
}
local interfaceChoices = {}

for _, item in ipairs(Network.Interfaces() or {}) do
  if item.Interface then
    foundInterfaces[item.Interface] = item.Address or false
  end
end

local function addInterfaceChoice(name)
  local address = foundInterfaces[name]
  local text

  if address and address ~= "" then
    text = name .. " (" .. address .. ")"
  else
    text = name .. " (no link)"
  end

  table.insert(interfaceChoices, text)
  InterfaceLookup[text] = {
    Name = name,
    Address = address or nil
  }
end

addInterfaceChoice("LAN A")
addInterfaceChoice("LAN B")

local additionalInterfaceNames = {}
for name, _ in pairs(foundInterfaces) do
  if name ~= "LAN A" and name ~= "LAN B" then
    table.insert(additionalInterfaceNames, name)
  end
end
table.sort(additionalInterfaceNames)

for _, name in ipairs(additionalInterfaceNames) do
  addInterfaceChoice(name)
end

Controls.interface.Choices = interfaceChoices

local function syncInterfaceControl()
  local receiverInterface = selectedreceiver and selectedreceiver["interface"]

  if receiverInterface then
    local currentName = receiverInterface.String
    for text, interface in pairs(InterfaceLookup) do
      if interface.Name == currentName then
        Controls.interface.String = text
        return
      end
    end
  end

  -- LAN A is the default when the receiver has no matching saved interface.
  for text, interface in pairs(InterfaceLookup) do
    if interface.Name == "LAN A" then
      Controls.interface.String = text
      if receiverInterface then
        receiverInterface.String = "LAN A"
      end
      return
    end
  end
end

Controls.interface.EventHandler = function(ctrl)
  local interface = InterfaceLookup[ctrl.String]
  if not interface then
    return
  end

  print("Interface:", interface.Name)
  print("IP:", interface.Address or "No link")

  if not selectedreceiver or not selectedreceiver["interface"] then
    print("Cannot set interface: embedded Media Stream Receiver interface control is unavailable")
    return
  end

  -- The receiver expects the interface name, not the UI label containing its IP.
  selectedreceiver["interface"].String = interface.Name
end

syncInterfaceControl()

-- Artwork is fetched by the Core; UCI clients only receive an SVG legend.
local MAX_LOGO_BYTES = 512 * 1024
local MAX_LOGO_DIMENSION = 512
local function svgLegend(svg)
    return rapidjson.encode({
        DrawChrome = false,
        IconData = Crypto.Base64Encode(svg),
        Legend = "",
    })
end
local fallbackSvg = [[<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 300 300">
<rect x="0" y="0" width="300" height="300" rx="30" ry="30" fill="#ffffff"/>
<rect x="35" y="90" width="230" height="165" rx="22" fill="#374151"/>
<path d="M65 90 L225 40" stroke="#9ca3af" stroke-width="12" stroke-linecap="round"/>
<circle cx="105" cy="173" r="46" fill="#9ca3af"/><circle cx="105" cy="173" r="29" fill="#374151"/>
<rect x="172" y="126" width="60" height="18" fill="#9ca3af"/>
<path d="M174 174 H233 M174 199 H233" stroke="#9ca3af" stroke-width="10"/>
</svg>]]
local fallbackLegend = svgLegend(fallbackSvg)

local function renderLogo(state, svg)
    if state.resultIndex then
        svg = '<svg xmlns="http://www.w3.org/2000/svg" width="62" height="60" viewBox="0 0 62 60">'
            .. '<g transform="translate(3 2) scale(0.186666667)">' .. svg .. '</g></svg>'
    end
    state.control.Legend = svgLegend(svg)
end
local logoStates = {}
local activeLogoRequest = nil
-- Keep just the most recent successful artwork, plus a dedicated active-station cache.
local lastLogoUrl, lastLogoSvg, stationLogoUrl, stationLogoSvg
local lastLogoFailureTime = nil

local function logoFailure(reason)
    local now = os.time()
    if not lastLogoFailureTime or now - lastLogoFailureTime >= 10 then
        print("Station logo: " .. reason .. "; using radio placeholder (messages limited to one per 10s)")
        lastLogoFailureTime = now
    end
end

local function registerLogo(control)
    control.Boolean = false
    -- Disabled controls are dimmed in Live/Emulate, including their SVG artwork.
    -- Keep artwork enabled; the momentary handler clears presses without tuning.
    control.IsDisabled = false
    control.Legend = fallbackLegend
    control.EventHandler = function(c) c.Boolean = false end
    local state = { control = control, revision = 0 }
    logoStates[#logoStates + 1] = state
    return state
end
local stationLogo = registerLogo(Controls.StationLogo)
local presetLogo = registerLogo(Controls.PresetFavicon)
local resultLogos = {}
for i, control in ipairs(Controls.SelectBtn) do
    resultLogos[i] = registerLogo(control)
    resultLogos[i].resultIndex = i
end

local function headerValue(headers, name)
    for key, value in pairs(headers or {}) do
        if type(key) == "string" and key:lower() == name then
            if type(value) == "table" then value = value[1] end
            return type(value) == "string" and value or nil
        end
    end
    return nil
end

local function pngError(code, data, err, headers)
    if err and err ~= "" then return "download error: " .. tostring(err) end
    if code ~= 200 then return "HTTP " .. tostring(code) end
    if type(data) ~= "string" or #data == 0 then return "empty image" end
    local length = tonumber(headerValue(headers, "content-length"))
    if #data > MAX_LOGO_BYTES or (length and length > MAX_LOGO_BYTES) then return "image exceeds 512 KiB" end
    local contentType = headerValue(headers, "content-type")
    if contentType then
        contentType = contentType:lower():match("^%s*([^;%s]+)")
        if contentType ~= "image/png" and contentType ~= "image/x-png"
            and contentType ~= "application/octet-stream" then return "unexpected Content-Type" end
    end
    if data:sub(1, 8) ~= "\137PNG\r\n\26\n" then return "invalid PNG signature" end
    local function uint32(pos)
        local a, b, c, d = data:byte(pos, pos + 3)
        return ((a * 256 + b) * 256 + c) * 256 + d
    end
    local pos, hasHeader, hasData = 9, false, false
    while pos + 11 <= #data do
        local size = uint32(pos)
        local kind = data:sub(pos + 4, pos + 7)
        if size > #data - pos - 11 then return "truncated PNG chunk" end
        if not hasHeader then
            if kind ~= "IHDR" or size ~= 13 then return "missing PNG header" end
            local width, height = uint32(pos + 8), uint32(pos + 12)
            if width < 1 or height < 1 or width > MAX_LOGO_DIMENSION or height > MAX_LOGO_DIMENSION then
                return "invalid or oversized PNG dimensions"
            end
            local depth, color, compression, filter, interlace = data:byte(pos + 16, pos + 20)
            local depths = { [0] = {1, 2, 4, 8, 16}, [2] = {8, 16}, [3] = {1, 2, 4, 8},
                [4] = {8, 16}, [6] = {8, 16} }
            local validDepth = false
            for _, allowed in ipairs(depths[color] or {}) do
                if depth == allowed then validDepth = true end
            end
            if not validDepth or compression ~= 0 or filter ~= 0 or interlace > 1 then
                return "invalid PNG header fields"
            end
            hasHeader = true
        elseif kind == "IHDR" then return "duplicate PNG header" end
        if kind == "IDAT" and size > 0 then hasData = true end
        if kind == "IEND" then
            if size == 0 and hasData and pos + 11 == #data then return nil end
            return "invalid PNG ending"
        end
        pos = pos + size + 12
    end
    return "incomplete PNG"
end

local pumpLogos
-- Round the backing tile, never the artwork: trimmed logos can touch every edge.
-- An inset keeps the complete image clear of the tile's rounded corners.
local function artworkSvg(data)
    return '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="300" height="300" viewBox="0 0 300 300">'
        .. '<rect x="0" y="0" width="300" height="300" rx="30" ry="30" fill="#ffffff"/>'
        .. '<image x="12" y="12" width="276" height="276" preserveAspectRatio="xMidYMid meet" xlink:href="data:image/png;base64,'
        .. Crypto.Base64Encode(data) .. '"/></svg>'
end

pumpLogos = function()
    if activeLogoRequest then return end
    for _, state in ipairs(logoStates) do
        if state.pending then
            state.pending = false
            local url, revision = state.url, state.revision
            local cached = url == stationLogoUrl and stationLogoSvg
                or url == lastLogoUrl and lastLogoSvg
            if cached then
                renderLogo(state, cached)
                if state == stationLogo then stationLogoUrl, stationLogoSvg = url, cached end
            else
                local request = { state = state, revision = revision }
                activeLogoRequest = request
                local function done(_, code, data, err, headers)
                    if activeLogoRequest ~= request then return end
                    activeLogoRequest = nil
                    if state.revision == revision then
                        local reason = pngError(code, data, err, headers)
                        if not reason then
                            local ok, svg = pcall(function()
                                local svgString = artworkSvg(data)
                                renderLogo(state, svgString)
                                return svgString
                            end)
                            if ok then
                                lastLogoUrl, lastLogoSvg = url, svg
                                if state == stationLogo then stationLogoUrl, stationLogoSvg = url, svg end
                            else reason = "SVG encoding failed" end
                        end
                        if reason then
                            renderLogo(state, fallbackSvg)
                            logoFailure(reason)
                        end
                    end
                    pumpLogos()
                end
                -- Download buffers the body before this callback. The byte limit above
                -- bounds encoding/cache memory, not HttpClient's receive buffer.
                local ok, err = pcall(function()
                    HttpClient.Download {
                        Url = "https://images.weserv.nl/?url=" .. urlEncode(url)
                            -- Trim uniform outer padding before fitting the visible logo.
                            .. "&output=png&w=300&h=300&fit=inside&trim=1",
                        Headers = { Accept = "image/png" }, Timeout = 10, EventHandler = done
                    }
                end)
                if not ok then done(nil, 0, nil, tostring(err), {}) end
                return
            end
        end
    end
end

local function setLogo(state, url, stationKey)
    url = type(url) == "string" and url:match("^%s*(.-)%s*$") or ""
    if not url:match("^https?://[^/%s?#]+") or url:find("[%s%c]") then url = "" end
    if state.url == url and state.stationKey == stationKey then return end
    state.url, state.stationKey = url, stationKey
    state.revision = state.revision + 1
    state.control.Boolean = false
    renderLogo(state, fallbackSvg)
    state.pending = url ~= "" and Properties["Enable Logo Pages"].Value
    local cached = url == stationLogoUrl and stationLogoSvg
        or url == lastLogoUrl and lastLogoSvg
    if state.pending and cached then
        renderLogo(state, cached)
        state.pending = false
        if state == stationLogo then stationLogoUrl, stationLogoSvg = url, cached end
    end
    pumpLogos()
end

function setFaviconControl(index, url)
    local hidden = url == EMPTY_RESULT_FAVICON
    local station = stations[index]
    local key = not hidden and station and ((station.url or "") .. "\n" .. (station.name or "")) or nil
    setLogo(resultLogos[index], hidden and "" or url, key)
    Controls.SelectBtn[index].IsInvisible = hidden
    Controls.ResultName[index].IsInvisible = hidden
    Controls.ResultName[index].Legend = not hidden and station and station.name or ""
end

function setNowPlayingFavicon(url)
    setLogo(stationLogo, url, currentStation and currentStation.url)
end

function funcResetUI()
  for i, _ in pairs(Controls.SelectBtn) do
    setFaviconControl(i, EMPTY_RESULT_FAVICON)
  end

end

function formatStationName(name)
  if not name or name == "" then
    return ""
  end

  if string.len(name) <= 100 then
    return name
  end

  return string.sub(name, 1, 97) .. "..."
end

-- ICY reader: audio is discarded incrementally; only headers and metadata are retained.
function icyUrl(url)
  if type(url) ~= "string" or url:find("[%s%c]") then return nil end
  local scheme, authority, path = url:match("^(https?)://([^/#?]+)(.*)$")
  if not scheme or authority:find("@", 1, true) then return nil end
  local host, port = authority:match("^([^:]+):(%d+)$")
  host = host or authority
  if host:find(":", 1, true) then return nil end
  port = tonumber(port) or (scheme == "https" and 443 or 80)
  if port < 1 or port > 65535 then return nil end
  path = path:gsub("#.*$", "")
  if path == "" then path = "/" elseif path:sub(1, 1) == "?" then path = "/" .. path end
  return { scheme = scheme, authority = authority, host = host, port = port, path = path }
end

function parseIcyMetadata(block)
  local fields = {}
  block = block:gsub("%z+$", "")
  -- A quote terminates a value only when followed by a field separator.
  for key, value in block:gmatch("([%w_]+)%s*=%s*'(.-)'%s*;") do
    fields[key:lower()] = value
  end
  return fields
end

icyGeneration = 0
icySelectedUrl = nil
icyEnabled = nil
icySocket = nil -- Keep the active socket reachable for Q-SYS garbage collection.
icyWorkingUrl = nil -- Only retained for the current station and enable session.

function stopIcy()
  icyGeneration = icyGeneration + 1
  local old = icySocket
  icySocket = nil
  if old then old:Disconnect() end
end

function startIcy(url, redirects, cachedAttempt)
  stopIcy()
  local generation = icyGeneration
  local target = icyUrl(url)
  if not target then
    Controls.MetadataStatus.String = "Unsupported metadata URL"
    return
  end
  if not TcpSocket then
    Controls.MetadataStatus.String = "Metadata socket unavailable"
    return
  end
  local socket = target.scheme == "https" and TcpSocket.NewTls() or TcpSocket.New()
  icySocket = socket
  socket.ReadTimeout = 20
  socket.WriteTimeout = 10
  socket.ReconnectTimeout = 0
  local buffer, headersDone, interval, remaining, metadataLength = "", false, nil, nil, nil
  local metadata, chunked, chunkRemaining, chunkEnding = "", false, nil, false
  local finished = false
  local function active() return not finished and generation == icyGeneration end
  local function finish(message, retry)
    if not active() then return end
    finished = true
    Controls.StreamTitle.String = ""
    Controls.StreamUrl.String = ""
    Controls.MetadataStatus.String = message
    socket:Disconnect()
    -- A direct URL can expire or stop resolving. Re-discover it through the
    -- selected URL after one failed cached attempt, including HTTP failures.
    if cachedAttempt then icyWorkingUrl, retry = nil, true end
    if retry then
      Timer.CallAfter(function()
        if generation == icyGeneration then
          local cached = icyWorkingUrl ~= nil and icyWorkingUrl ~= icySelectedUrl
          startIcy(cached and icyWorkingUrl or icySelectedUrl, 0, cached)
        end
      end, 15)
    end
  end
  local function audio(data)
    local pos = 1
    while pos <= #data and active() do
      if remaining > 0 then
        local count = math.min(remaining, #data - pos + 1)
        remaining, pos = remaining - count, pos + count
      elseif metadataLength == nil then
        metadataLength = data:byte(pos) * 16
        metadata, pos = "", pos + 1
        if metadataLength == 0 then remaining, metadataLength = interval, nil end
      else
        local count = math.min(metadataLength - #metadata, #data - pos + 1)
        metadata, pos = metadata .. data:sub(pos, pos + count - 1), pos + count
        if #metadata == metadataLength then
          local fields = parseIcyMetadata(metadata)
          if fields.streamtitle ~= nil then Controls.StreamTitle.String = fields.streamtitle end
          if fields.streamurl ~= nil then Controls.StreamUrl.String = fields.streamurl end
          Controls.MetadataStatus.String = "Receiving ICY metadata"
          remaining, metadataLength, metadata = interval, nil, ""
        end
      end
    end
  end
  local function receive(data)
    buffer = buffer .. data
    if not headersDone then
      local boundary = buffer:find("\r\n\r\n", 1, true)
      if not boundary then
        if #buffer > 16384 then finish("Metadata headers too large", false) end
        return
      end
      if boundary > 16384 then finish("Metadata headers too large", false); return end
      local header = buffer:sub(1, boundary - 1)
      buffer = buffer:sub(boundary + 4)
      local status = tonumber(header:match("^HTTP/%d%.%d (%d+)") or header:match("^ICY (%d+)"))
      local fields = {}
      for key, value in header:gmatch("\r\n([^:%s]+):%s*([^\r\n]*)") do
        fields[key:lower()] = value:match("^(.-)%s*$")
      end
      if status == 301 or status == 302 or status == 303 or status == 307 or status == 308 then
        local location = fields.location
        if not location or (redirects or 0) >= 5 then finish("Metadata redirect failed", false); return end
        if location:sub(1, 2) == "//" then location = target.scheme .. ":" .. location
        elseif not location:match("^%a[%w+.-]*:") then
          local base = target.scheme .. "://" .. target.authority
          if location:sub(1, 1) == "/" then location = base .. location
          elseif location:sub(1, 1) == "?" then location = base .. target.path:gsub("%?.*$", "") .. location
          else location = base .. (target.path:match("^([^?]*/)") or "/") .. location end
        end
        startIcy(location, (redirects or 0) + 1, cachedAttempt)
        return
      end
      if status ~= 200 then finish("Metadata HTTP error " .. tostring(status), true); return end
      interval = tonumber(fields["icy-metaint"])
      if not interval or interval < 1 or interval > 16777216 or interval % 1 ~= 0 then
        finish("ICY metadata unavailable", false); return
      end
      if fields["content-encoding"] and fields["content-encoding"]:lower() ~= "identity" then
        finish("Unsupported metadata encoding", false); return
      end
      local transfer = (fields["transfer-encoding"] or ""):lower()
      if transfer ~= "" and transfer ~= "identity" and transfer ~= "chunked" then
        finish("Unsupported metadata transfer", false); return
      end
      chunked = transfer == "chunked"
      remaining, headersDone = interval, true
      icyWorkingUrl = url
      cachedAttempt = false -- A validated ICY response makes this endpoint usable again.
      Controls.MetadataStatus.String = "Waiting for ICY title"
    end
    if not chunked then audio(buffer); buffer = ""; return end
    while active() do
      if chunkEnding then
        if #buffer < 2 then return end
        if buffer:sub(1, 2) ~= "\r\n" then finish("Invalid metadata chunk", true); return end
        buffer, chunkEnding, chunkRemaining = buffer:sub(3), false, nil
      elseif chunkRemaining == nil then
        local eol = buffer:find("\r\n", 1, true)
        if not eol then
          if #buffer > 1024 then finish("Invalid metadata chunk", false) end
          return
        end
        local line = buffer:sub(1, eol - 1)
        local hex = line:match("^(%x+)$") or line:match("^(%x+);.*$")
        chunkRemaining = hex and tonumber(hex, 16)
        if not chunkRemaining or chunkRemaining > 16777216 then finish("Invalid metadata chunk", false); return end
        buffer = buffer:sub(eol + 2)
        if chunkRemaining == 0 then finish("Metadata stream ended; retrying", true); return end
      else
        if #buffer == 0 then return end
        local count = math.min(chunkRemaining, #buffer)
        audio(buffer:sub(1, count))
        buffer, chunkRemaining = buffer:sub(count + 1), chunkRemaining - count
        if chunkRemaining == 0 then chunkEnding = true end
      end
    end
  end
  Controls.MetadataStatus.String = "Connecting for ICY metadata"
  socket.EventHandler = function(sock, event, err)
    if not active() then return end
    if event == TcpSocket.Events.Connected then
      sock:Write("GET " .. target.path .. " HTTP/1.1\r\nHost: " .. target.authority
        .. "\r\nUser-Agent: Q-SYS-Radio-Search\r\nIcy-MetaData: 1\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n")
    elseif event == TcpSocket.Events.Data then
      -- Parsing can disconnect this socket (for example, on an HTTP redirect).
      -- Check active before touching it again. Read returns up to the requested
      -- bytes, so there is no need to query BufferLength on TCP/TLS sockets.
      while active() do
        local data = sock:Read(8192)
        if not data or data == "" then break end
        receive(data)
        if #data < 8192 then break end
      end
    elseif event == TcpSocket.Events.Closed or event == TcpSocket.Events.Error or event == TcpSocket.Events.Timeout then
      local reason = event == TcpSocket.Events.Timeout and "timeout"
        or (event == TcpSocket.Events.Error and "socket error" or "remote closed")
      if err and tostring(err) ~= "" then reason = reason .. ": " .. tostring(err) end
      local endpoint = target.scheme .. "://" .. target.authority
      local stage = (redirects or 0) > 0 and "redirect destination"
        or (url ~= icySelectedUrl and "last working stream" or "selected stream")
      print("ICY metadata: " .. endpoint .. " (" .. stage .. "): " .. reason
        .. (headersDone and " after headers" or " before headers") .. "; retrying in 15s")
      finish("Metadata disconnected: " .. target.host .. " (" .. reason .. "); retrying", true)
    end
  end
  socket:Connect(target.host, target.port)
  Timer.CallAfter(function()
    if active() and not headersDone then finish("Metadata connection timed out; retrying", true) end
  end, 20)
end

function syncIcy()
  local url = selectedreceiver and selectedreceiver.url and selectedreceiver.url.String or ""
  local enabled = selectedreceiver and selectedreceiver.enable and selectedreceiver.enable.Boolean or false
  if url == icySelectedUrl and enabled == icyEnabled then return end
  icySelectedUrl, icyEnabled = url, enabled
  icyWorkingUrl = nil
  stopIcy()
  Controls.StreamTitle.String, Controls.StreamUrl.String = "", ""
  if not enabled or url == "" then Controls.MetadataStatus.String = "Metadata idle"
  else startIcy(url, 0) end
end

function watchIcy()
  syncIcy()
  Timer.CallAfter(watchIcy, 1)
end

function tuneStation(station)
  if not station or type(station.url) ~= "string" or station.url == "" then
    return false
  end
  if not selectedreceiver or not selectedreceiver["url"] then
    print("Cannot tune station: embedded Media Stream Receiver is unavailable")
    return false
  end

  selectedreceiver["url"].String = station.url
  if selectedreceiver["enable"] then
    selectedreceiver["enable"].Boolean = true
    Controls.enable.Boolean = selectedreceiver["enable"].Boolean
  end
  stationRevision = stationRevision + 1
  currentStation = { url = station.url, name = station.name or station.url, favicon = station.favicon or "" }
  Controls.NowPlaying.String = formatStationName(currentStation.name)
  setNowPlayingFavicon(currentStation.favicon)
  syncIcy()
  return true
end

function selectStation(index)
  if tuneStation(stations[index]) then
    Controls.StrSearchResult.Value = index
  end
end

local function refreshPresets()
    local choices = {}
    for i = 1, presetCount do
        local preset = presets[tostring(i)]
        choices[i] = string.format("%02d - %s", i, preset and formatStationName(preset.name) or "Empty")
    end
    Controls.PresetList.Choices = choices
    Controls.PresetList.String = choices[selectedPreset]
    local preset = presets[tostring(selectedPreset)]
    Controls.PresetName.String = preset and preset.name or "Empty preset"
    Controls.PresetUrl.String = preset and preset.url or ""
    setLogo(presetLogo, preset and preset.favicon or "", preset and preset.url)
    Controls.PresetRecall.IsDisabled = preset == nil
    Controls.PresetDelete.IsDisabled = preset == nil
end

local function loadPresets()
    presets = {}
    local data = Controls.PresetData.String
    if data ~= "" then
        local ok, saved = pcall(rapidjson.decode, data)
        if not ok or type(saved) ~= "table" then
            Controls.PresetStatus.String = "Saved preset data could not be read."
            refreshPresets()
            return
        end
        for key, preset in pairs(saved) do
            local slot = tonumber(key)
            if slot and slot >= 1 and slot <= 40 and slot == math.floor(slot)
                and type(preset) == "table" and type(preset.url) == "string" and preset.url ~= ""
                and type(preset.name) == "string" and type(preset.favicon) == "string" then
                presets[tostring(slot)] = { url = preset.url, name = preset.name, favicon = preset.favicon }
            end
        end
    end
    refreshPresets()
end

Controls.PresetList.EventHandler = function(ctrl)
    for i, choice in ipairs(ctrl.Choices) do
        if ctrl.String == choice then
            selectedPreset = i
            Controls.PresetStatus.String = ""
            refreshPresets()
            return
        end
    end
end

Controls.PresetSave.EventHandler = function()
    local receiverUrl = selectedreceiver and selectedreceiver["url"]
    if not receiverUrl or receiverUrl.String == "" then
        Controls.PresetStatus.String = "Play a station before saving a preset."
        return
    end
    if not currentStation or currentStation.url ~= receiverUrl.String then
        Controls.PresetStatus.String = "Station details are unavailable. Select the station in Search first."
        return
    end
    presets[tostring(selectedPreset)] = {
        url = currentStation.url, name = currentStation.name, favicon = currentStation.favicon
    }
    Controls.PresetData.String = rapidjson.encode(presets)
    refreshPresets()
    Controls.PresetStatus.String = "Saved preset " .. selectedPreset .. ": " .. currentStation.name
end

Controls.PresetRecall.EventHandler = function()
    local preset = presets[tostring(selectedPreset)]
    if not preset then
        Controls.PresetStatus.String = "This preset is empty."
    elseif tuneStation(preset) then
        Controls.PresetStatus.String = "Recalled preset " .. selectedPreset .. ": " .. preset.name
    else
        Controls.PresetStatus.String = "Cannot recall: embedded receiver unavailable."
    end
end

Controls.PresetDelete.EventHandler = function()
    presets[tostring(selectedPreset)] = nil
    Controls.PresetData.String = rapidjson.encode(presets)
    refreshPresets()
    Controls.PresetStatus.String = "Deleted preset " .. selectedPreset .. "."
end

Controls.PresetData.EventHandler = loadPresets
Controls.PresetStatus.String = "Save replaces the selected slot. Delete clears it without stopping playback."

function funcGetRadio(requestId, tbl, code, data, err, headers)
    print(string.format(
        "HTTP response from '%s': Return Code=%i; Error=%s",
        tbl.Url, code, err or "None"
    ))

    if requestId ~= searchRequestId then
        print("Ignoring stale radio search response")
        return
    end

    if code ~= 200 then
        Timer.CallAfter(funcSearchRadio, 1)
        return
    end

    local radios = rapidjson.decode(data)
    if not radios then return end

    stations = {}
    local choices = {}
    local indexByUrl = {}

    for _, station in ipairs(radios) do
        local name = station.name or "Unknown"
        local url = station.url_resolved
        if type(url) ~= "string" or url == "" then url = station.url end
        local clickcount = tonumber(station.clickcount) or 0
        local votes = tonumber(station.votes) or 0
        local favicon = station.favicon or ""
        local codec = string.upper(station.codec or "")

        -- Preserve exact paths and query parameters: they can identify different streams.
        if (codec == "MP3" or codec == "MPEG") and type(url) == "string" and url ~= "" then
            local index = indexByUrl[url]
            local existing = index and stations[index]
            if not existing or clickcount > existing.clickcount
                or (clickcount == existing.clickcount and votes > existing.votes) then
                local entry = {
                    name = name,
                    url = url,
                    clickcount = clickcount,
                    votes = votes,
                    favicon = favicon or ""
                }
                if index then
                    stations[index] = entry
                else
                    table.insert(stations, entry)
                    indexByUrl[url] = #stations
                end
            end
        end
    end

    table.sort(stations, function(a, b)
        return a.clickcount > b.clickcount
    end)

    -- Clear previous result images
    funcResetUI()

    local faviconUrls = {}

    -- Build UI choices and names first
    for i, s in ipairs(stations) do
        if i <= RESULT_COUNT then
          s.displayName = formatStationName(s.name)
          choices[i] = s.displayName

          if s.favicon and s.favicon ~= "" then
            faviconUrls[i] = s.favicon
          else
            faviconUrls[i] = ""
          end

        end
    end

    Controls.StrSearchResult.Choices = choices

    if #choices > 0 then
        Controls.StrSearchResult.Value = 1
    end

    -- Queue artwork after results are filtered and named.
    for i, favicon in ipairs(faviconUrls) do
        setFaviconControl(i, favicon)
    end
end

countryCodeByName = {}

function funcSearchRadio()
    searchRequestId = searchRequestId + 1
    local requestId = searchRequestId

    local choices = {"Searching..."}
    Controls.StrSearchResult.Choices = choices

    local search = string.gsub(strSearch.String, " ", "+")
    local countryCode = selectedCountryCode or "BE"
    local countryFilter = ""
    if countryCode and countryCode ~= "" then
        countryFilter = "&countrycode=" .. countryCode
    end

    local url = string.format(
        "https://de1.api.radio-browser.info/json/stations/search?name=%s%s&codec=mp3&limit=200&hidebroken=true&order=name",
        search,
        countryFilter
    )

    HttpClient.Get{
        Url = url,
        Timeout = 30,
        EventHandler = function(tbl, code, data, err, headers)
            funcGetRadio(requestId, tbl, code, data, err, headers)
        end
    }
end

function funcParceCountryCodes(tbl, code, data, err, headers)
    print(string.format(
        "HTTP response from '%s': Return Code=%i; Error=%s",
        tbl.Url, code, err or "None"
    ))

    local countries = rapidjson.decode(data)

    local choices = {}
    countryCodeByName = {}

    for _, country in ipairs(countries) do
        if country.name and country.iso_3166_1 then
            table.insert(choices, country.name)
            countryCodeByName[country.name] = country.iso_3166_1
        end
    end

    table.sort(choices)
    table.insert(choices, 1, "All")
    countryCodeByName["All"] = ""

    Controls.Country_Code.Choices = choices
    if countryCodeByName[Controls.Country_Code.String] == nil then
        Controls.Country_Code.String = "All"
    end
    selectedCountryCode = countryCodeByName[Controls.Country_Code.String]
end

function funcGetCountryCodes()
  url = "https://de1.api.radio-browser.info/json/countries"
  HttpClient.Get{Url = url, Timeout = 30, EventHandler = funcParceCountryCodes}
end

strSearch.EventHandler = function()
  funcResetUI()
  strSearch.String = string.gsub(strSearch.String, "[\r\n]", "")
  funcSearchRadio()
end

Controls.Country_Code.EventHandler = function(ctrl)
    local selectedCountryName = ctrl.String

    selectedCountryCode = countryCodeByName[selectedCountryName]

    print("Selected country: " .. tostring(selectedCountryName))
    print("Selected country code: " .. tostring(selectedCountryCode))

    searchRequestId = searchRequestId + 1
    Controls.StrSearch.String = ""
    Controls.StrSearchResult.Choices = {}
    funcResetUI()
end

Controls.StrSearchResult.EventHandler = function()
  -- Select by row so identical names can point to different streams.
  selectStation(Controls.StrSearchResult.Value)
end

if Controls.SelectBtn then
  for i, btn in ipairs(Controls.SelectBtn) do
    btn.EventHandler = function()
      btn.Boolean = false
      if btn.IsInvisible then return end
      selectStation(i)
    end
    Controls.ResultName[i].EventHandler = function()
      Controls.ResultName[i].Boolean = false
      if Controls.ResultName[i].IsInvisible then return end
      selectStation(i)
    end
  end
end

function urlEncode(str)
    if not str then return "" end

    return string.gsub(str, "([^%w%-_%.~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
end

function funcRestoreNowPlaying(tbl, code, data, err, headers, streamUrl, revision)
    print(string.format(
        "Restore response: Return Code=%i; Error=%s",
        code,
        err or "None"
    ))

    if code ~= 200 or revision ~= stationRevision or not selectedreceiver
        or not selectedreceiver["url"] or selectedreceiver["url"].String ~= streamUrl then
        return
    end

    local stations = rapidjson.decode(data)

    if stations and stations[1] and stations[1].name then
        currentStation = { url = streamUrl, name = stations[1].name, favicon = stations[1].favicon or "" }
        Controls.NowPlaying.String = formatStationName(stations[1].name)
        setNowPlayingFavicon(currentStation.favicon)
        print("Restored station: " .. stations[1].name)
    end
end

function funcGetCurrentStation()
    if not selectedreceiver or not selectedreceiver["url"] then
        return
    end

    local streamUrl = selectedreceiver["url"].String

    if streamUrl == nil or streamUrl == "" then
        return
    end

    local lookupUrl =
        "https://de1.api.radio-browser.info/json/stations/byurl?url="
        .. urlEncode(streamUrl)

    print("Looking up station: " .. lookupUrl)

    local revision = stationRevision
    HttpClient.Get{
        Url = lookupUrl,
        Timeout = 10,
        EventHandler = function(tbl, code, data, err, headers)
            funcRestoreNowPlaying(tbl, code, data, err, headers, streamUrl, revision)
        end
    }
end

loadPresets()
watchIcy()

Controls.StrSearch.String = ""

choices = {}
Controls.StrSearchResult.Choices = choices

funcGetCountryCodes()

Timer.CallAfter(function()
    funcGetCurrentStation()
end, 2)

funcResetUI()

end -- if Controls
