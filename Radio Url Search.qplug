PluginInfo = {
	-- Use a tilde (~) to seperate the name into a folder
    Name = "Radio Url Search",
	-- Use semantic versioning
    Version = "3.1.0",
	-- Use a GUID for the Id (Note: Avoid changing the Id for a plugin once it is set)
    Id = "ec2efe7f-9127-4081-8b07-90ee9e526dda",
	-- The square brackets allow for a multi-line string
    Description = [[Search for a radio stations streaming URL by name and country using the Radio Browser API.]],
    Author = "Jens Claerebout",
    ShowDebug = true
}

